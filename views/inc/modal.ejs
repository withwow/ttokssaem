

<!-- Modal : Confirm -->
<div class="modal fade" id="modalConfirm" tabindex="-1" role="dialog" aria-labelledby="modalConfirmTitle"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header modal-colored-header bg-warning text-white">
                <h5 class="modal-title font-weight-bolder" id="modalConfirmTitle"></h5>
                <!--button class="close" type="button" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button-->
            </div>
            <div class="modal-body m-3 py-3" id="modalConfirmBody"></div>
            <div class="modal-footer">
                <button class="btn btn-warning " id="btnConfirmYes" type="button">확인</button>
                 <button class="btn btn-secondary" id="btnConfirmNo" type="button" data-dismiss="modal">닫기</button>
           </div>
        </div>
    </div>
</div>
<!-- End --------------------------------------------------------------------------------------->


