<!-- Modal : FileUpload -->
<div class="modal fade" id="fileModal" tabindex="-1" role="dialog" aria-labelledby="modalAlertTitle" aria-hidden="true" style="z-index:1041;">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalAlertTitle">파일업로드</h5>
                <button class="btn-close close-dialog" type="button" data-dismiss="modal" aria-label="Close"  name="btn_close01" id="btn_close01"></button>
            </div>
            <div class="modal-body bg-light-primary border-light-primary border-top border-bottom mt-3">
                <form name="filefrm" id="filefrm" method="POST" enctype="multipart/form-data">
                    <input type="hidden" id="filetarget" name="filetarget">
                    <input type="file"  class="upload" id="files" name="files">
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal" id="btnClose">취소</button>
                <button class="btn btn-primary" type="button" data-dismiss="modal" id="btnFileUpload">업로드</button></div>
        </div>
    </div>
</div>
    
<!-- End --------------------------------------------------------------------------------------->

