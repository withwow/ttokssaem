    <script type="text/javascript">
      var runtimeplanlist = <%- JSON.stringify(runtimeplanlist)%>;
      var methodlist = ['<span class="text-secondary">입실</span>','<span class="text-secondary">퇴실</span>','<span class="text-primary">중식</span>','<span class="text-primary">석식</span>','<span class="text-warning">외출</span>','<span class="text-warning">복귀</span>']
      var statuslist = ['입실','퇴실','','종료','','','','','','예정','']

      $(document).ready(function () {

        initRuntimePlan();

        // 버튼 선택

      }); // end ready

      function timeStamp(hour, minute) {
        if(hour < 10)
          hour =  `0${hour}`;
        if(minute < 10)
          minute =  `0${minute}`;
        
        return `${hour}:${minute}`;
      }

      function getMethod(method) {
        return methodlist[method];
      }

      function getStatus(status) {
        return statuslist[status];
      }

      function addSchedule(id, data) {

        var li = document.createElement('li');
        li.setAttribute('class', 'list-group-item');

        var row = document.createElement('div');
        row.setAttribute("class", "row");

        var col1 = document.createElement('div');
        col1.setAttribute("class", "col-sm-4");

        col1.innerHTML = getMethod(data.method);

        var col2 = document.createElement('div');
        col2.setAttribute("class", "col-sm-4");

        col2.innerHTML = timeStamp(data.hour, data.minute);

        var col3 = document.createElement('div');
        col3.setAttribute("class", "col-sm-4");

        var inputsetting = document.createElement('input');
        inputsetting.setAttribute("id", `inputsetting_${data.masterplanid}`);
        inputsetting.setAttribute("type", "hidden");
        inputsetting.setAttribute("value", data.status);


        var btnsetting = document.createElement('button');
        btnsetting.setAttribute("id", `btnsetting_${data.masterplanid}`);
        btnsetting.setAttribute("type", "button");
        btnsetting.setAttribute("class", "btn-sm btn-dark text-white");
        btnsetting.onclick = function(){
          let status = $(`#inputsetting_${data.masterplanid}`).val();
          changeNextStatus(data.masterplanid, status);
        }
        var tn = document.createTextNode(getStatus(data.status));
        btnsetting.appendChild(tn); 

        col3.appendChild(inputsetting);
        col3.appendChild(btnsetting);

        row.appendChild(col1);
        row.appendChild(col2);
        row.appendChild(col3);
        li.appendChild(row);

        document.getElementById(id).appendChild(li);
      }

      function initRuntimePlan() {
        for(let i = 0; i < runtimeplanlist.length; i++) {
          addSchedule('runtimeplan', runtimeplanlist[i]);
        }

      }

      function changeNextStatus(masterplanid, status) {
        if(status == 0) status = 1;
        else if(status == 1) status = 3;
        else if(status == 3) status = 9;
        else if(status == 9) status = 0;


        var url = '/v1/changeNextStatus'
        var data = {
          masterplanid: masterplanid,
          status: status
        };

        $.ajax({
          type: "POST",
          url: url,
          dataType: 'json',
          data: data,
          async: false,
          success: function (info) {
            code = info.code;
            if (code == 0) {
              $(`#inputsetting_${masterplanid}`).val(status);
              $(`#btnsetting_${masterplanid}`).html(getStatus(status));
            } else {
              fn_ModalAlert('알림', '비정상 응답입니다.');
              return false;
            }
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },            
        })
      }


  </script>
    
  </head>
  <body>
