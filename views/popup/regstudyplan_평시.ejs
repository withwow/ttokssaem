    <script type="text/javascript">
      $(document).ready(function () {

        let today = new Date();
        today.setHours(today.getHours() - 2); // 02시까지 영업이니
        $('#plandate').val(fn_getY_M_D(today));

        loadStudyPlan();

        $('#plandate').change(function() {
          loadStudyPlan();
        });

        // 버튼 클릭
        $( "#btnload" ).click(function() {
          yesterdayStudyPlan();
        });

        $( "#btndownload" ).click(function() {
          downloadProcess();
        });

        $( "#btnupdate" ).click(function() {
          $("#frm").submit();
        });

        $("#frm").submit(function(){ 
          confirmProcess();
          return false;
        });

      }); // end ready

      function checkClass(obj, idx) {
        if(obj.checked) {
          $("input[name=classyn]:eq(" + idx + ")").val('Y'); 
        } else {
          $("input[name=classyn]:eq(" + idx + ")").val('N'); 
        }
      }

      function studyClass(obj, idx) {
        if(obj.value == '') {
          $("input[name=classyn]:eq(" + idx + ")").val('N'); 
          $("input[name=classcheck]:eq(" + idx + ")").prop("checked", false); 
        } else {
          $("input[name=classyn]:eq(" + idx + ")").val('Y'); 
          $("input[name=classcheck]:eq(" + idx + ")").prop("checked", true); 
        }
      }

      function confirmProcess(){

        if($("#userid")[0].selectedIndex == 0 ) {
          alert('담당자 선택');
          $("#userid")[0].focus();
          return false; 
        }

        if($('#userpw').val() == ''){
          alert('비밀번호 입력');
          $("#userpw").focus();
          return false;
        }

        var title = '확인';
        var message = '진행 하시겠습니까?';

        var confirmIs = fn_ModalConfirm(title, message);  
          confirmIs.then( function (ret){ 
            if( ret ==   1   ) { 
              doProcess();
            } else {
              return false;
            }
        });        
      }

      function downloadProcess(){
        var url = '/v1/downloadStudyplan';
        var data = $("#frm").serialize();

        $.ajax({
          url: url,
          data: data,
          type: 'POST',
          cache: false,
          xhrFields: {
              responseType: "blob",
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },   
        })
        .done(function (blob, status, xhr) {
          // check for a filename
          var fileName = "";
          var disposition = xhr.getResponseHeader("Content-Disposition");

          if (disposition && disposition.indexOf("attachment") !== -1) {
            var filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
            var matches = filenameRegex.exec(disposition);

            if (matches != null && matches[1]) {
              fileName = decodeURI(matches[1].replace(/['"]/g, ""));
            }
          }

          // for IE
          if (window.navigator && window.navigator.msSaveOrOpenBlob) {
            window.navigator.msSaveOrOpenBlob(blob, fileName);
          } else {
            var URL = window.URL || window.webkitURL;
            var downloadUrl = URL.createObjectURL(blob);

            if (fileName) {
              var a = document.createElement("a");

              // for safari
              if (a.download === undefined) {
                  window.location.href = downloadUrl;
              } else {
                  a.href = downloadUrl;
                  a.download = fileName;
                  document.body.appendChild(a);
                  a.click();
              }
            } else {
                window.location.href = downloadUrl;
            }
          }
        });
      }      

      function doProcess(){

        var url = '/v1/insStudyplan';
        var title = '알림';
        var message = '처리 되었습니다';

        var data = $("#frm").serialize();

        $.ajax({
          type: "POST",
          url: url,
          dataType: 'json',
          data: data,
          async: false,
          success: function (info) {
            code = info.code;
            if (code == 0) {
              fn_ModalAlert(title, message);
            } else if (code == 404) {
              fn_ModalAlert(title, '비밀번호가 틀립니다');
            } else {
              fn_ModalAlert('알림', '비정상 응답입니다.');
              return false;
            }
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },            
        })
      }

      function initStudyPlan(newArray) {
        for(let i = 0; i < newArray.length; i++) {
            setStudyPlan(newArray[i]);
        }
      }

      function setStudyPlan(data) {
        let idx = Number(data.class - 1);
        let study = data.study;

        $("input[name=classyn]:eq(" + idx + ")").val('Y'); 
        $("input[name=classcheck]:eq(" + idx + ")").prop("checked", true); 
        $("textarea[name=study]:eq(" + idx + ")").val(study); 
 
      }

      function resetStudyPlan() {
        for(let idx = 0; idx < 10; idx++) {
          $("input[name=classyn]:eq(" + idx + ")").val('N'); 
          $("input[name=classcheck]:eq(" + idx + ")").prop("checked", false); 
          $("textarea[name=study]:eq(" + idx + ")").val(''); 
        }
      }

      function loadStudyPlan() {

        resetStudyPlan();

        var url = '/v1/selStudyplan'
        var data = $("#frm").serialize();

        $.ajax({
          type: "POST",
          url: url,
          dataType: 'json',
          data: data,
          async: false,
          success: function (info) {
            code = info.code;
            if (code == 0) {
              initStudyPlan(info.data.lists);
            } else {
              fn_ModalAlert('알림', '비정상 응답입니다.');
              return false;
            }
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },            
        })
      }


      function yesterdayStudyPlan() {

        resetStudyPlan();

        var url = '/v1/selStudyplan'
        var data = {};
        data.memberid = $("#memberid").val();

        let today = new Date();
        today.setHours(today.getHours() - 26); // 02시까지 영업이니, 24+2
        data.plandate = fn_getY_M_D(today);
        
        $.ajax({
          type: "POST",
          url: url,
          dataType: 'json',
          data: data,
          async: false,
          success: function (info) {
            code = info.code;
            if (code == 0) {
              initStudyPlan(info.data.lists);
            } else {
              fn_ModalAlert('알림', '비정상 응답입니다.');
              return false;
            }
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },            
        })
      }   

  </script>
    
