    <script type="text/javascript">
      var runtimeplanlist = <%- JSON.stringify(runtimeplanlist)%>;
      var masterplanlist = <%- JSON.stringify(masterplanlist)%>;

      $(document).ready(function () {

        initRuntimePlan();

        initMasterPlan();

        // 파일 선택
        $("#runtimeplanfiles").on("change", function() {
          const selectedFile = this.files[0];
          $("#runtimeplan_file").val(selectedFile.name)
        });

        $("#masterplanfiles").on("change", function() {
          const selectedFile = this.files[0];
          $("#masterplan_file").val(selectedFile.name)
        });

        // 버튼 선택
        $( "#btnUploadRuntimePlan" ).click(function() {
          confirmRuntimePlanProcess();
        });
        
        $( "#btnUploadMasterPlan" ).click(function() {
          confirmMasterPlanProcess();
        });

        $( "#btnCopyMasterToRuntime" ).click(function() {
          confirmCopyMasterToRuntimeProcess();
        });

        $("#masterplanfrm").submit(function(){ 
        });



      }); // end ready

      function timeStamp(hour, minute) {
        if(hour < 10)
          hour =  `0${hour}`;
        if(minute < 10)
          minute =  `0${minute}`;
        
        return `${hour}:${minute}`;
      }

      function addSchedule(id, data) {

        let method = ['<span class="text-secondary">입실</span>','<span class="text-secondary">퇴실</span>','<span class="text-primary">중식</span>','<span class="text-primary">석식</span>','<span class="text-warning">외출</span>','<span class="text-warning">복귀</span>']

        var li = document.createElement('li');
        li.setAttribute('class', 'list-group-item');

        var row = document.createElement('div');
        row.setAttribute("class", "row");

        var col1 = document.createElement('div');
        col1.setAttribute("class", "col-sm-6");

        col1.innerHTML = method[data.method];

        var col2 = document.createElement('div');
        col2.setAttribute("class", "col-sm-6");

        col2.innerHTML = timeStamp(data.hour, data.minute);

        row.appendChild(col1);
        row.appendChild(col2);
        li.appendChild(row);

        document.getElementById(id).appendChild(li);
      }

      function reloadMasterPlan(newArray) {
        $('#sunday-masterplan').html('');
        $('#monday-masterplan').html('');
        $('#tuesday-masterplan').html('');
        $('#wednesday-masterplan').html('');
        $('#thursday-masterplan').html('');
        $('#friday-masterplan').html('');
        $('#saturday-masterplan').html('');

        masterplanlist.length = 0;
        masterplanlist = newArray;

        initMasterPlan();
      }

      function initMasterPlan() {

        for(let i = 0; i < masterplanlist.length; i++) {

          if(masterplanlist[i].dayofweek == 0){
            addSchedule('sunday-masterplan', masterplanlist[i]);
          }

          if(masterplanlist[i].dayofweek == 1){
            addSchedule('monday-masterplan', masterplanlist[i]);
          }

          if(masterplanlist[i].dayofweek == 2){
            addSchedule('tuesday-masterplan', masterplanlist[i]);
          }

          if(masterplanlist[i].dayofweek == 3){
            addSchedule('wednesday-masterplan', masterplanlist[i]);
          }

          if(masterplanlist[i].dayofweek == 4){
            addSchedule('thursday-masterplan', masterplanlist[i]);
          }

          if(masterplanlist[i].dayofweek == 5){
            addSchedule('friday-masterplan', masterplanlist[i]);
          }

          if(masterplanlist[i].dayofweek == 6){
            addSchedule('saturday-masterplan', masterplanlist[i]);
          }

        }
      }


      function reloadRuntimePlan(newArray) {
        $('#sunday-runtimeplan').html('');
        $('#monday-runtimeplan').html('');
        $('#tuesday-runtimeplan').html('');
        $('#wednesday-runtimeplan').html('');
        $('#thursday-runtimeplan').html('');
        $('#friday-runtimeplan').html('');
        $('#saturday-runtimeplan').html('');

        runtimeplanlist.length = 0;
        runtimeplanlist = newArray;

        initRuntimePlan();
      }


      function initRuntimePlan() {

        for(let i = 0; i < runtimeplanlist.length; i++) {

          if(runtimeplanlist[i].dayofweek == 0){
            addSchedule('sunday-runtimeplan', runtimeplanlist[i]);
          }

          if(runtimeplanlist[i].dayofweek == 1){
            addSchedule('monday-runtimeplan', runtimeplanlist[i]);
          }

          if(runtimeplanlist[i].dayofweek == 2){
            addSchedule('tuesday-runtimeplan', runtimeplanlist[i]);
          }

          if(runtimeplanlist[i].dayofweek == 3){
            addSchedule('wednesday-runtimeplan', runtimeplanlist[i]);
          }

          if(runtimeplanlist[i].dayofweek == 4){
            addSchedule('thursday-runtimeplan', runtimeplanlist[i]);
          }

          if(runtimeplanlist[i].dayofweek == 5){
            addSchedule('friday-runtimeplan', runtimeplanlist[i]);
          }

          if(runtimeplanlist[i].dayofweek == 6){
            addSchedule('saturday-runtimeplan', runtimeplanlist[i]);
          }

        }
      }

      function confirmCopyMasterToRuntimeProcess(){

        if($("#userid")[0].selectedIndex == 0 ) {
          alert('담당자 선택');
          $("#userid")[0].focus();
          return false; 
        }

        if($('#userpw').val() == '') {
          alert('비밀번호 입력');
          $("#userpw").focus();
          return false;
        }

        var title = '확인';
        var message = '진행 하시겠습니까?';

        var confirmIs = fn_ModalConfirm(title, message);  
          confirmIs.then( function (ret){ 
            if( ret ==   1   ) { 
              copyMasterToRuntimePlanProcess();
            } else {
              return false;
            }
        });        
      }

      function copyMasterToRuntimePlanProcess(){

        var url = '/v1/copyMasterToRuntimePlan';
        var title = '알림';
        var message = '처리 되었습니다';

        var data = {};
        data.memberid = $("#memberid").val();
        data.userid = $("#userid").val();
        data.userpw = $("#userpw").val();

        $.ajax({
          type: "POST",
          url: url,
          dataType: 'json',
          data: data,
          async: false,
          success: function (info) {
            code = info.code;
            if (code == 0) {

              reloadRuntimePlan(info.data.lists);

              fn_ModalAlert(title, message);
            } else if (code == 404) {
              fn_ModalAlert(title, '비밀번호가 틀립니다');
            } else {
              fn_ModalAlert('알림', '비정상 응답입니다.');
              return false;
            }
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },            
        })        
      }


      function confirmRuntimePlanProcess(){

        if($("#runtimeplan_file").val() == '') {
          alert('파일 선택');
          return false; 
        }

        if($("#userid")[0].selectedIndex == 0 ) {
          alert('담당자 선택');
          $("#userid")[0].focus();
          return false; 
        }

        if($('#userpw').val() == '') {
          alert('비밀번호 입력');
          $("#userpw").focus();
          return false;
        }

        var title = '확인';
        var message = '진행 하시겠습니까?';

        var confirmIs = fn_ModalConfirm(title, message);  
          confirmIs.then( function (ret){ 
            if( ret ==   1   ) { 
              uploadRuntimePlanProcess();
            } else {
              return false;
            }
        });        
      }

      function uploadRuntimePlanProcess(){

        $('#errormsg').html('');

        var url = '/v1/runtimeplan';
        var title = '알림';
        var message = '처리 되었습니다';

        var formData = new FormData();
        formData.append("runtimeplanfiles", $('#runtimeplanfiles')[0].files[0]);
        formData.append("memberid", $("#memberid").val());
        formData.append("userid", $("#userid").val());
        formData.append("userpw", $("#userpw").val());

        $.ajax({
          type: "POST",
          url: url,
          processData : false,
          cache: false,
          contentType: false,
          data: formData,
          success: function (info) {
            code = info.code;
            if (code == 0) {
              
              reloadRuntimePlan(info.data.lists);

              fn_ModalAlert(title, message);
            } else if (code == 404) {
              fn_ModalAlert(title, '비밀번호가 틀립니다');
            } else if (code == 500) {
              $('#errormsg').html(info.data.errormsg);
              fn_ModalAlert(title, '형식오류');
            } else {
              fn_ModalAlert('알림', '비정상 응답입니다.');
              return false;
            }
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },            
        })
      }

      function confirmMasterPlanProcess(){

        if($("#masterplan_file").val() == '') {
          alert('파일 선택');
          return false; 
        }

        if($("#userid")[0].selectedIndex == 0 ) {
          alert('담당자 선택');
          $("#userid")[0].focus();
          return false; 
        }

        if($('#userpw').val() == '') {
          alert('비밀번호 입력');
          $("#userpw").focus();
          return false;
        }

        var title = '확인';
        var message = '진행 하시겠습니까?';

        var confirmIs = fn_ModalConfirm(title, message);  
          confirmIs.then( function (ret){ 
            if( ret ==   1   ) { 
              uploadMasterPlanProcess();
            } else {
              return false;
            }
        });        
      }

      function uploadMasterPlanProcess(){

        $('#errormsg').html('');

        var url = '/v1/masterplan';
        var title = '알림';
        var message = '처리 되었습니다';

        var formData = new FormData();
        formData.append("masterplanfiles", $('#masterplanfiles')[0].files[0]);
        formData.append("memberid", $("#memberid").val());
        formData.append("userid", $("#userid").val());
        formData.append("userpw", $("#userpw").val());

        $.ajax({
          type: "POST",
          url: url,
          processData : false,
          cache: false,
          contentType: false,
          data: formData,
          success: function (info) {
            code = info.code;
            if (code == 0) {
              
              reloadMasterPlan(info.data.lists);

              fn_ModalAlert(title, message);
            } else if (code == 404) {
              fn_ModalAlert(title, '비밀번호가 틀립니다');
            } else if (code == 500) {
              $('#errormsg').html(info.data.errormsg);
              fn_ModalAlert(title, '형식오류');
            } else {
              fn_ModalAlert('알림', '비정상 응답입니다.');
              return false;
            }
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },            
        })
      }
  </script>
    
