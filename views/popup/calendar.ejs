    <style>
      body {
        margin: 40px 10px;
        padding: 0;
        font-family: Arial, Helvetica Neue, Helvetica, sans-serif;
        font-size: 14px;
      }
    
      #calendar {
        max-width: 1300px;
        margin: 0 auto;
      }
    </style>

    <script type="text/javascript">
      var calendar;
      $(document).ready(function () {
        initCalendar();
      }); // end ready

      function insMemo(memo, start, end, allDay) {
        var url = '/v1/calendarInsMemo';
          var title = '알림';
          var message = '메모등록';

          var data = {};
          data.memo = memo;
          data.start = start;
          data.memberid = '<%= memberinfo.memberid %>';

          $.ajax({
            type: 'POST',
            url: url,
            dataType: 'json',
            data: data,
            async: false,
            success: function (info) {
              code = info.code;
              if (code == 0) {
                
                $('#success_toast_body').html(`${message} 성공`);
                $('#success_toast').toast('show');

                // 성공하면 생성
                calendar.refetchEvents();

                // calendar.addEvent({
                //   tt: 'Memo',
                //   memoid: info.data.lastid,
                //   title: memo,
                //   start: start,
                //   end: end,
                //   allDay: allDay,
                // });
              } else {
                $('#error_toast_body').html(`${message} 실패`);
                $('#error_toast').toast('show');
                return false;
              }
            },
            error: function(response, ajaxOptions, thrownError) {
              $('#error_toast_body').html(`${membername} 오류 ${thrownError}`);
                $('#error_toast').toast('show');
            },            
          })        
      }

      function delMemo(memoid, event) {
        var url = '/v1/calendarDelMemo';
          var title = '알림';
          var message = '삭제';

          var data = {};
          data.memoid = memoid;
          data.memberid = '<%= memberinfo.memberid %>';

          $.ajax({
            type: 'POST',
            url: url,
            dataType: 'json',
            data: data,
            async: false,
            success: function (info) {
              code = info.code;
              if (code == 0) {
                $('#success_toast_body').html(`${message} 성공`);
                $('#success_toast').toast('show');

                // 성공하면 삭제
                // event.remove();
                calendar.refetchEvents();

              } else {
                $('#error_toast_body').html(`${message} 실패`);
                $('#error_toast').toast('show');
                return false;
              }
            },
            error: function(response, ajaxOptions, thrownError) {
              $('#error_toast_body').html(`${membername} 오류 ${thrownError}`);
                $('#error_toast').toast('show');
            },            
          })        
      }

      function initCalendar() {
        var calendarEl = document.getElementById('calendar');
        calendar = new FullCalendar.Calendar(calendarEl, {
          locale: 'ko',
          navLinks: true, // can click day/week names to navigate views
          selectable: true,
          selectMirror: true,
          select: function(arg) {
            // console.log('select ' + JSON.stringify(arg));
            var title = prompt('메모를 입력하세요 :');
            if (title) {
              insMemo(title, arg.startStr, arg.endStr, arg.allDay);
            }
            calendar.unselect()
          },
          eventClick: function(arg) {
            // console.log('eventClick ' + JSON.stringify(arg));
            if(arg.event.extendedProps.tt === 'Memo') {
              if (confirm('선택한 메모를 삭제하시겠습니까?')) {
                // arg.event.remove();
                delMemo(arg.event.extendedProps.memoid, arg.event);
              }
            }
          },
          editable: true,
          dayMaxEvents: true, // allow "more" link when too many events
          eventSources: [
             {
              url: '/v1/calendarEnterance', // use the `url` property
              method: 'POST',
              extraParams: {
                memberid: '<%= memberinfo.memberid %>',
              },   
              success: function(content, xhr) {
                // console.log(content);
                return content.data.lists;
              },
              color: '#F5F5F5',   // an option!
              textColor: '#666666' // an option!
            },
            {
              url: '/v1/calendarMemo', // use the `url` property
              method: 'POST',
              extraParams: {
                memberid: '<%= memberinfo.memberid %>',
              },   
              success: function(content, xhr) {
                // console.log(content);
                return content.data.lists;
              },
              textColor: 'white' // an option!
            },
            {
              url: '/v1/calendarPayment', // use the `url` property
              method: 'POST',
              extraParams: {
                memberid: '<%= memberinfo.memberid %>',
              },   
              success: function(content, xhr) {
                // console.log(content);
                return content.data.lists;
              },
              color: '#ff9f89',   // an option!
            }            
          ]
        });

        calendar.render();

      }
      
    </script>
    
  </head>
  <body>
