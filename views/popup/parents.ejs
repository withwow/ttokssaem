    <script language="JavaScript">
      attachStaff = {
        idx:0,
        add:function(parentid, parentname){ // 파일필드 추가
            var o = this;
            var idx = o.idx;
  
            // input group
            var div = document.createElement('div');
            div.id = 'attachStaff' + idx;
            div.setAttribute("class", "input-group mb-3");
  
            // hidden
            var hidden = document.createElement('input');
            hidden.id = 'parentid' + idx;
            hidden.setAttribute("type", "hidden");
            hidden.setAttribute("value", parentid);

            // delete user
            var prepend = document.createElement('div');
            prepend.setAttribute("class", "input-group-prepend");
  
            var btndel = document.createElement('button');
            btndel.setAttribute("type", "button");
            btndel.setAttribute("class", "btn btn-light-danger text-danger");
            btndel.onclick = function(){o.del(idx)}

            var icondel = document.createElement('i');
            icondel.setAttribute("class", "mdi mdi-delete-forever");
            btndel.appendChild(icondel);
            prepend.appendChild(btndel);

            // input
            var input = document.createElement('input');
            input.id = 'parentname' + idx;
            input.setAttribute("class", "form-control");
            input.setAttribute("placeholder", "담당자를 선택하세요");
            input.style.cssText = "background-color:transparent;";
            input.setAttribute("value", parentname);

            // add user
            var btnadd = document.createElement('button');
            btnadd.setAttribute("type", "button");
            btnadd.setAttribute("class", "btn btn-light-info text-info");
            btnadd.onclick = function(){o.modal(idx)}

            var iconuser = document.createElement('i');
            iconuser.setAttribute("class", "mdi mdi-account");
            btnadd.appendChild(iconuser);

            div.appendChild(hidden);
            div.appendChild(prepend);
            div.appendChild(input);
            div.appendChild(btnadd);

            document.getElementById('attachStaff').appendChild(div);
  
            o.idx++;
        },
        modal:function(idx) {
          $('#selecteduserinput').val(idx);
          openUserSelectModal();
        },
        del:function(idx){ // 파일필드 삭제
          let parentid = $('#parentid' + idx).val();
          if(parentid === ''){
            //  선택되지 않았으니 그냥 삭제
            document.getElementById('attachStaff').removeChild(document.getElementById('attachStaff' + idx));
          } else {
            if($("#userid")[0].selectedIndex == 0 ) {
              alert('담당자 선택');
              $("#userid")[0].focus();
              return false; 
            }       

            if($('#userpw').val() == ''){
              alert('비밀번호 입력');
              $("#userpw").focus();
              return false;
            }

            if(!confirm('삭제 하시겠습니까?')){
              return;
            } else {
              let data = {};
              data.memberid = $('#memberid').val();
              data.parentid = parentid;
              data.userid = $("#userid option:selected").val();
              data.userpw = $('#userpw').val();

              $.ajax({
                crossOrigin : true,
                type: "POST",
                url: "/v1/delParents",
                dataType: 'json',
                data: data,
                async: false,
                success: function (info) {
                    code = info.code;
                    if (code === 0) {
                      document.getElementById('attachStaff').removeChild(document.getElementById('attachStaff' + idx));
                    } else if (code === 404) {
                      fn_ModalAlert('알림', '비밀번호 불일치');
                      return false;
                    } else if (code === 999) {
                        fn_ModalAlert('알림', '다시 로그인 하여 주세요');
                        location.reload(); 
                    } else {
                        fn_ModalAlert('알림', '비정상 응답입니다.');
                        return false;
                    }
                },
                error: function(response, ajaxOptions, thrownError) {
                    fn_ModalAlert('오류', ''+ thrownError);
                },                     
              }); // end  $.ajax              
            }
          }
        }
      }
    </script>

    <script type="text/javascript">
      let parentslist = <%- JSON.stringify(parentslist)%>
      $(document).ready(function () {

        initParentsList();
      }); // end ready

      function initParentsList() {
        for(let i = 0; i < parentslist.length; i++) {
          // 학부모
          attachStaff.add(parentslist[i].memberid, parentslist[i].membername);
        }
      }

      
      function openUserSelectModal() {
          var $user = $('#modalUser');
          $('#modalUserContent').css('height','400px');
          $('#modalUserTitle').html('학부모 선택');

          let src = '/popup/memberlist?type=P';
          $('#modalUserBody').html('<iframe class="embed-responsive-item" width="100%" height="100%" src=" ' + src + ' " scrolling="no" allowfullscreen></iframe>');

          $user.modal('show');
                
          $('#btnUserYes').off('click').click(function () {
              $('#modalUserBody').html('');
              $user.modal('hide');
          });

          $('#btnUserClose').off('click').click(function () {
              $('#modalUserBody').html('');
              $user.modal('hide');
          });
      }

      // Delegate
      function fromChild_SetUserData(user) {

        let selecteduserinput = $('#selecteduserinput').val();
        addSubStaff(selecteduserinput, user.memberid, user.membername)

        var $user = $('#modalUser');
        $('#modalUserBody').html('');
        $user.modal('hide');
      }

      function addSubStaff(selecteduserinput, parentid, parentname) {

        if($("#userid")[0].selectedIndex == 0 ) {
          alert('담당자 선택');
          $("#userid")[0].focus();
          return false; 
        }       

        if($('#userpw').val() == ''){
          alert('비밀번호 입력');
          $("#userpw").focus();
          return false;
        }

        let data = {};
        data.memberid = $('#memberid').val();
        data.parentid = parentid;
        data.userid = $("#userid option:selected").val();
        data.userpw = $('#userpw').val();

        $.ajax({
          crossOrigin : true,
          type: "POST",
          url: "/v1/addParents",
          dataType: 'json',
          data: data,
          async: false,
          success: function (info) {
              code = info.code;
              if (code === 0) {
                $('#parentid' + selecteduserinput).val(parentid);
                $('#parentname' + selecteduserinput).val(parentname);
              } else if (code === 404) {
                  fn_ModalAlert('알림', '비밀번호 불일치');
                  return false;
              } else if (code === 999) {
                  fn_ModalAlert('알림', '다시 로그인 하여 주세요');
                  location.reload(); 
              } else {
                  fn_ModalAlert('알림', '비정상 응답입니다.');
                  return false;
              }
          },
          error: function(response, ajaxOptions, thrownError) {
              fn_ModalAlert('오류', ''+ thrownError);
          },                     
        }); // end  $.ajax  
      }

  </script>
    
