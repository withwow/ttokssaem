    <script type="text/javascript">
      $(document).ready(function () {
        // 데이터 불러오기
        loadM2mInfo();

        $( "#btnupdate" ).click(function() {
          $('#mode').val('mod');
          $("#frm").submit();
        });

        $( "#btndelete" ).click(function() {
          $('#mode').val('del');
          $("#frm").submit();
        });

        $("#frm").submit(function(){ 
          confirmProcess();
          return false;
        });

      }); // end ready

      function loadM2mInfo() {
        let data = {};

        <% if (typeof param.m2mid != "undefined" && param.m2mid) { %>                   
          data.m2mid = '<%= param.m2mid %>';
        <% } %>                                        

        if(data.m2mid === undefined){
          return false;
        }

        $.ajax({
            crossOrigin : true,
            type: "POST",
            url: "/v1/selM2m",
            dataType: 'json',
            data: data,
            async: false,
            success: function (info) {
                code = info.code;
                if (code === 0) {
                  //let lists = info.data;
                  setM2mInfo(info.data);  
                } else if (code === 999) {
                    fn_ModalAlert('알림', '다시 로그인 하여 주세요');
                    location.reload(); 
                } else {
                    fn_ModalAlert('알림', '비정상 응답입니다.');
                    return false;
                }
            },
            error: function(response, ajaxOptions, thrownError) {
                fn_ModalAlert('오류', ''+ thrownError);
            },                     
        }); // end  $.ajax        
      }

      function confirmProcess(){
        var title = '확인';
        var message = '';
        message = '등록 하시겠습니까?';

        if($("#userid")[0].selectedIndex == 0 ) {
          alert('담당자 선택');
          $("#userid")[0].focus();
          return false; 
        }

        if($('#userpw').val() == ''){
          alert('비밀번호 입력');
          $("#userpw").focus();
          return false;
        }

        if($('#answer').val() == ''){
          alert('답변 내용 입력');
          $("#answer").focus();
          return false;
        }

        var confirmIs = fn_ModalConfirm(title, message);  
          confirmIs.then( function (ret){ 
            if( ret ==   1   ) { 
              saveM2mInfo();
            } else {
              return false;
            }
        });        
      }

      function saveM2mInfo(){
        var url = '';
        var title = '알림';
        var message = '';
        message = '등록되었습니다';
        url = "/v1/answerM2M";

        var data = $("#frm").serialize();

        $.ajax({
          type: "POST",
          url: url,
          dataType: 'json',
          data: data,
          async: false,
          success: function (info) {
            code = info.code;
            if (code == 0) {
              fn_ModalAlert(title, message);
            } else if (code == 404) {
              fn_ModalAlert('알림', '비밀번호가 틀립니다.');
              return false;
            } else {
              fn_ModalAlert('알림', '비정상 응답입니다.');
              return false;
            }
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },            
        })
      }

      function setM2mInfo(data){

        $('#m2mid').val(data.m2mid);

        $('#memberid').val(data.memberid);
        $('#membername').val(data.membername);

        $('#question').val(data.question);
        $('#answer').val(data.answer);


        $('#regdate').val(data.regdate);
        $('#findate').val(data.findate);
        $('#answerid').val(data.answerid);

        if(data.status == 'Y') {
          $('#answerarea1').hide();
          $('#answerarea2').hide();
        }
      }

  </script>
    
  </head>
  <body>
