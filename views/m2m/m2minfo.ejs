      <!-- Bread crumb and right sidebar toggle -->
      <!-- -------------------------------------------------------------- -->
      <div class="page-breadcrumb">
        <div class="row">
          <div class="col-5 align-self-center">
            <h4 class="page-title">1:1 문의정보</h4>
            <div class="d-flex align-items-center">
              <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                  <li class="breadcrumb-item"><a href="/m2m">1:1 문의</a></li>
                  <li class="breadcrumb-item active" aria-current="page">1:1 문의정보</li>
                </ol>
              </nav>
            </div>
          </div>
        </div>
      </div>
      <!-- -------------------------------------------------------------- -->
      <!-- End Bread crumb and right sidebar toggle -->
      <!-- -------------------------------------------------------------- -->

      <!-- -------------------------------------------------------------- -->
      <!--  정보   -->
      <!-- -------------------------------------------------------------- -->
      <div class="row">
        <div class="col-lg-12">

            <div class="card">
              <form id="frm" method="POST">
              <input type="hidden" id="m2mid" name="m2mid" value="">
              <input type="hidden" id="memberid" name="memberid" value="">
              <div class="card-body">
                <!-- row -->
                <div class="row mb-3">
                  <div class="col-md-12">
                    <h3>기본 정보</h3>
                  </div>
                </div>
                <!-- end row -->
                <!-- row -->
                <div class="row mb-3">
                  <div class="col-md-12">
                    <label class="control-label">질문자</label>
                    <input type='text' id="membername" name="membername" class="form-control" />              
                  </div>
                </div>
                <!-- end row -->


                <!-- row -->
                <div class="row mb-3">
                  <div class="col-md-12">
                    <label class="control-label">질문일자</label>
                    <input type='text' id="regdate" name="regdate" class="form-control" readonly/>              
                  </div>
                </div>
                <!-- end row -->

                <!-- row -->
                <div class="row mb-3">
                  <div class="col-md-12">
                    <label class="control-label">답변 담당자</label>
                    <input type='text' id="answerid" name="answerid" class="form-control" readonly/>              
                  </div>
                </div>
                <!-- end row -->                

                <!-- row -->
                <div class="row mb-3">
                  <div class="col-md-12">
                    <label class="control-label">답변일자</label>
                    <input type='text' id="findate" name="findate" class="form-control" readonly/>              
                  </div>
                </div>
                <!-- end row -->

                <!-- row -->
                <div class="row mb-3">
                  <div class="col-md-12">
                    <h3>답변 정보</h3>
                  </div>
                </div>
                <!-- end row -->

                <!-- row -->
                <div class="row mb-3">
                  <div class="col-md-12">
                    <label class="control-label">문의사항</label>
                    <input type='text' id="question" name="question" class="form-control" />              
                  </div>
                </div>
                <!-- end row -->

                <!-- row -->
                <div class="row mb-3">
                  <div class="col-md-12">
                    <label class="control-label">답변</label>
                    <input type='text' id="answer" name="answer" class="form-control" />              
                  </div>
                </div>
                <!-- end row -->

                <!-- row -->
                <div class="row mb-3">
                  <div class="col-md-12">
                    <h3></h3>
                  </div>
                </div>
                <!-- end row -->

                <!-- row -->
                <div class="row mb-3" id="answerarea1">            
                  <div class="col-md-6">
                      <label class="control-label">담당자</label>
                      <select class="form-control" id='userid' name='userid'>   
                        <option value='' selected>-- 처리하고자 하는 담당자 --</option>
                        <% for(var i = 0; i < userlist.length; i++){ %>
                          <option value='<%= userlist[i].userid %>'><%= userlist[i].username %></option>                   
                        <% } %>                
                      </select>   
                  </div>
      
                  <div class="col-md-6" >
                    <label class="control-label">비밀번호</label>
                    <input class="form-control password" id="userpw" name="userpw" class="form-control" autocomplete="off"/>
                  </div>
                </div>
                <!-- end row -->
                <!-- form-actions -->
                <div class="form-actions" id="answerarea2">
                  <span class="text-danger">간단한 문장으로 답변 가능합니다.</span>
                  <div class="card-body border-top">
                    <button type="button" id="btnupdate" class="btn btn-success rounded-pill px-4"> 
                      <div class="d-flex align-items-center">
                          <i data-feather="save" class="feather-sm me-1 fill-icon"></i> 답변하기
                      </div>
                    </button>
                  </div>
                </div>
                <!-- end form-actions -->
      
              </div>
              <!-- end card body-->
              </form>
            </div>
          <!-- ---------------------
              end Person Info
