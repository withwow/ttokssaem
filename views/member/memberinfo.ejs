    <script type="text/javascript">
      $(document).ready(function () {
        // 데이터 불러오기
        loadMemberInfo();

        // 버튼 클릭
        $( "#btnCheckMemberId" ).click(function() {
          checkMemberId();
        });

        $( "#btnSchoolSearch" ).click(function() {
          openSchoolSelectModal();
        });

        $( "#btnupdate" ).click(function() {
          $('#mode').val('mod');
          $("#frm").submit();
        });

        $( "#btndelete" ).click(function() {
          $('#mode').val('del');
          $("#frm").submit();
        });

        $("#frm").submit(function(){ 
          confirmProcess();
          return false;
        });


      }); // end ready

      function checkMemberId() {
        let data = {};

        data.memberid = $('#memberid').val();

        if(data.memberid === ''){
          return false;
        }

        $.ajax({
            crossOrigin : true,
            type: "POST",
            url: "/v1/checkMemberId",
            dataType: 'json',
            data: data,
            async: false,
            success: function (info) {
                code = info.code;
                if (code === 0) {
                  //let lists = info.data;
                  if( info.data.length !== 0)
                    fn_ModalAlert('알림', '이미 사용중인 아이디입니다.');
                  else
                  fn_ModalAlert('알림', '사용가능한 아이디입니다.');
                } else if (code === '999') {
                    fn_ModalAlert('알림', '다시 로그인 하여 주세요');
                    location.reload(); 
                } else {
                    fn_ModalAlert('알림', '비정상 응답입니다.');
                    return false;
                }
            },
            error: function(response, ajaxOptions, thrownError) {
                fn_ModalAlert('오류', ''+ thrownError);
            },                     
        }); // end  $.ajax        
      }

      function openSchoolSelectModal() {
        var $school = $('#modalSchool');
        $('#modalSchoolContent').css('height','600px');
        $('#modalSchoolTitle').html('학교 선택');

        $('#modalSchoolBody').html('<iframe class="embed-responsive-item" width="100%" height="100%" src="/popup/schoollist" scrolling="no" allowfullscreen></iframe>');

        $school.modal('show');
              
        $('#btnSchoolYes').off('click').click(function () {
            $('#modalSchoolBody').html('');
            $school.modal('hide');
        });

        $('#btnSchoolClose').off('click').click(function () {
            $('#modalSchoolBody').html('');
            $school.modal('hide');
        });
      }    

      // Delegate
      function fromChild_SetSchoolData(school) {
        $('#schoolcode').val(school.SD_SCHUL_CODE);
        $('#schoolname').val(school.SCHUL_NM);

        var $school = $('#modalSchool');
        $('#modalSchBody').html('');
        $school.modal('hide');

      }

      function removeMemberidReadonly() {
        $('#memberid').attr('readonly',false);
      }

      function selectCurrentBranch(branchid, branchname, disabled) {
        fn_Set_Select_Selected('branchid', branchid, branchname );

        <% if ( userinfo.branchid !== 'BR00000000' ) { %>                   
          $('#branchid').prop('disabled','disabled');
        <% } else { %>
          if( disabled )
            $('#branchid').attr('readonly',true);
        <% } %>   
      }

      function loadMemberInfo() {
        let data = {};

        <% if (typeof param.memberid != "undefined" && param.memberid) { %>                   
          data.memberid = '<%= param.memberid %>';
        <% } %>                                        

        if(data.memberid === undefined){

          selectCurrentBranch('<%= userinfo.branchid %>', 'empty', false)
          removeMemberidReadonly();
          
          return false;
        }

        $.ajax({
            crossOrigin : true,
            type: "POST",
            url: "/v1/selMember",
            dataType: 'json',
            data: data,
            async: false,
            success: function (info) {
                code = info.code;
                if (code === 0) {
                  //let lists = info.data;
                  setUserMemberInfo(info.data);  
                } else if (code === '999') {
                    fn_ModalAlert('알림', '다시 로그인 하여 주세요');
                    location.reload(); 
                } else {
                    fn_ModalAlert('알림', '비정상 응답입니다.');
                    return false;
                }
            },
            error: function(response, ajaxOptions, thrownError) {
                fn_ModalAlert('오류', ''+ thrownError);
            },                     
        }); // end  $.ajax        
      }

      function confirmProcess(){
        var mode = $('#mode').val();
        var title = '확인';
        var message = '';
        if(mode == 'reg'){
          message = '등록 하시겠습니까?';
        } else if(mode == 'mod'){
          message = '수정 하시겠습니까?';
        } if(mode == 'del'){
          message = '삭제 하시겠습니까?';
        }

        var confirmIs = fn_ModalConfirm(title, message);  
          confirmIs.then( function (ret){ 
            if( ret ==   1   ) { 
              saveMemberInfo();
            } else {
              return false;
            }
        });        
      }

      function saveMemberInfo(){
        var mode = $('#mode').val();

        var url = '';
        var title = '알림';
        var message = '';
        if(mode == 'reg'){
          // 등록 
          message = '등록되었습니다';
          url = "/v1/insMember";
        } else if(mode == 'mod'){
          // 수정
          message = '수정되었습니다';
          url = "/v1/updMember";
        } if(mode == 'del'){
          // 삭제
          message = '삭제되었습니다';
          url = "/v1/delMember";
        }

        var data = $("#frm").serialize();

        $.ajax({
          type: "POST",
          url: url,
          dataType: 'json',
          data: data,
          async: false,
          success: function (info) {
            code = info.code;
            if (code == 0) {
              fn_ModalAlert(title, message);
            } else {
              fn_ModalAlert('알림', '비정상 응답입니다.');
              return false;
            }
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },            
        })
      }

      function setUserMemberInfo(data){

        selectCurrentBranch(data.branchid, data.branchname, true);

        $('#memberid').val(data.memberid);
        $('#membername').val(data.membername);

        fn_Set_Select_Selected('type', data.type, '' );

        $('#schoolcode').val(data.schoolcode);
        $('#schoolname').val(data.schoolname);

        fn_Set_Select_Selected('grade', data.grade, '' );

        $('#contact').val(data.contact);
        $('#email').val(data.email);

        fn_Set_Radio_Checked('os', data.os);
        fn_Set_Radio_Checked('gender', data.gender);
        fn_Set_Radio_Checked('marketing', data.marketing);
        fn_Set_Radio_Checked('push', data.push);

        $('#regdate').val(data.regdate);
      }
  </script>
    
  </head>
  <body>
  <!-- -------------------------------------------------------------- -->
  <!-- Preloader - style you can find in spinners.css -->
