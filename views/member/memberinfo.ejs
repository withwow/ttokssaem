      <path id="steamL" d="M17 1C17 1 17 4.5 14 6.5C11 8.5 11 12 11 12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke="#2962FF"></path>
      <path id="steamR" d="M21 6C21 6 21 8.22727 19 9.5C17 10.7727 17 13 17 13" stroke="#2962FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>  </div>
  <!-- -------------------------------------------------------------- -->
	<!-- Main wrapper - style you can find in pages.scss -->
	<!-- -------------------------------------------------------------- -->
	<div id="main-wrapper">
    <%- include('../inc/header.ejs') %>    

    <%- include('../inc/nav.ejs') %>    

    <!-- -------------------------------------------------------------- -->
    <!-- Page wrapper  -->
    <!-- -------------------------------------------------------------- -->
    <div class="page-wrapper bg-white">
      <!-- -------------------------------------------------------------- -->
      <!-- Bread crumb and right sidebar toggle -->
      <!-- -------------------------------------------------------------- -->
      <div class="page-breadcrumb">
        <div class="row">
          <div class="col-5 align-self-center">
            <h4 class="page-title">회원정보</h4>
            <div class="d-flex align-items-center">
              <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                  <li class="breadcrumb-item"><a href="/member">회원 관리</a></li>
                  <li class="breadcrumb-item active" aria-current="page">회원정보</li>
                </ol>
              </nav>
            </div>
          </div>
        </div>
      </div>
      <!-- -------------------------------------------------------------- -->
      <!-- End Bread crumb and right sidebar toggle -->
      <!-- -------------------------------------------------------------- -->

      <!-- -------------------------------------------------------------- -->
      <!--  정보   -->
      <!-- -------------------------------------------------------------- -->
      <div class="row">
        <div class="col-lg-12">

          <div class="card">
            <form id="frm" method="POST">
              <% if (typeof param.memberid != "undefined" && param.memberid) { %>                   
                <input type="hidden" id="mode" name="mode" value="mod" />
              <% } else { %>
                <input type="hidden" id="mode" name="mode" value="reg" />
              <% } %>                                        
              <div class="card-body">
                <h4 class="card-title">기본 정보</h4>
                <div class="row">

                  <div class="col-md-12">
                    <div class="mb-3">
                      <label class="control-label">지점 <span class="text-danger">*</span></label>
                      <select class="form-control" id='branchid' name='branchid' required>   
                        <option value='' selected>-- 선택 --</option>                   
                        <% for(var i = 0; i < branchlist.length; i++){ %>
                          <option value='<%= branchlist[i].branchid %>'><%= branchlist[i].branchname %></option>                   
                        <% } %>
                      </select>                            
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="row mb-3">
                    <label class="control-label">회원 ID</label>
                    <div class="col-auto">
                      <input type="text" id="memberid" name="memberid" class="form-control" placeholder="" readonly>
                    </div>
                    <div class="col-auto">
                      <button type="button" id="btnCheckMemberId" class="btn btn-secondary rounded-pill px-4"> 
                        <div class="d-flex align-items-center">
                            <i data-feather="check" class="feather-sm me-1 fill-icon"></i> 중복 검사
                        </div>
                      </button>
                    </div>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">비밀번호</label>
                      <input type="text" id="memberpw" name="memberpw" class="form-control" placeholder="">
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">이름</label>
                      <input type="text" id="membername" name="membername" class="form-control" placeholder="">
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">구분</label>
                      <select class="form-control" id='type' name='type' required>   
                        <option value='' selected>-- 선택 --</option>                   
                        <option value='S'>학생</option>                   
                        <option value='P'>학부모</option>                   
                      </select>   
                    </div>
                  </div>

                  <div class="col-md-12">
                    <div class="mb-3">
                      <button type="button" id="btnSchoolSearch" class="btn btn-secondary rounded-pill px-4"> 
                        <div class="d-flex align-items-center">
                            <i data-feather="search" class="feather-sm me-1 fill-icon"></i> 학교 선택
                        </div>
                      </button>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">학교 ID</label>
                      <input type="text" id="schoolcode" name="schoolcode" class="form-control" placeholder="" readonly>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">학교명</label>
                      <input type="text" id="schoolname" name="schoolname" class="form-control" placeholder="" readonly>
                    </div>
                  </div>

                  <div class="col-md-12">
                    <div class="mb-3">
                      <label class="control-label">학년</label>
                      <select class="form-control" id='grade' name='grade' required>   
                        <option value='' selected>-- 선택 --</option>                   
                        <option value='1'>1학년</option>                   
                        <option value='2'>2학년</option>                   
                        <option value='3'>3학년</option>                   
                        <option value='4'>재수</option>                   
                        <option value='5'>기타</option>                   
                      </select>   
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">연락처</label>
                      <input type="text" id="contact" name="contact" class="form-control" placeholder="">
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">이메일</label>
                      <input type="text" id="email" name="email" class="form-control" placeholder="">
                    </div>
                  </div>


                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">성별</label>
                      <div class="col-9 border-start pb-2 pt-2">
                        <fieldset class="controls">
                            <div class="form-check">
                                <input type="radio" id="gender" name="gender" value="M" checked required id="styled_radio1" class="form-check-input">
                                <label class="form-check-label" for="styled_radio1">남</label>
                            </div>
                        </fieldset>
                        <fieldset>
                            <div class="form-check">
                                <input type="radio" id="gender" name="gender" value="F" id="styled_radio2" class="form-check-input">
                                <label class="form-check-label" for="styled_radio2">여</label>
                            </div>
                        </fieldset>
                      </div>
                    </div>
                  </div>    

                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">마케팅</label>
                      <div class="col-9 border-start pb-2 pt-2">
                        <fieldset class="controls">
                            <div class="form-check">
                                <input type="radio" id="marketing" name="marketing" value="Y" checked required id="styled_radio1" class="form-check-input">
                                <label class="form-check-label" for="styled_radio1">마케팅동의</label>
                            </div>
                        </fieldset>
                        <fieldset>
                            <div class="form-check">
                                <input type="radio" id="marketing" name="marketing" value="N" id="styled_radio2" class="form-check-input">
                                <label class="form-check-label" for="styled_radio2">마케팅동의안함</label>
                            </div>
                        </fieldset>
                      </div>
                    </div>
                  </div>    

                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">푸시</label>
                      <div class="col-9 border-start pb-2 pt-2">
                        <fieldset class="controls">
                            <div class="form-check">
                                <input type="radio" id="push" name="push" value="Y" checked required id="styled_radio1" class="form-check-input">
                                <label class="form-check-label" for="styled_radio1">수신</label>
                            </div>
                        </fieldset>
                        <fieldset>
                            <div class="form-check">
                                <input type="radio" id="push" name="push" value="N" id="styled_radio2" class="form-check-input">
                                <label class="form-check-label" for="styled_radio2">수신안함</label>
                            </div>
                        </fieldset>
                      </div>
                    </div>
                  </div>    

                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">OS</label>
                      <div class="col-9 border-start pb-2 pt-2">
                        <fieldset class="controls">
                            <div class="form-check">
                                <input type="radio" id="os" name="os" value="ios" checked required id="styled_radio1" class="form-check-input">
                                <label class="form-check-label" for="styled_radio1">iOS</label>
                            </div>
                        </fieldset>
                        <fieldset>
                            <div class="form-check">
                                <input type="radio" id="os" name="os" value="andr" id="styled_radio2" class="form-check-input">
                                <label class="form-check-label" for="styled_radio2">Android</label>
                            </div>
                        </fieldset>
                      </div>
                    </div>
                  </div>    

                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">등록일</label>
                      <input type="text" id="regdate" name="regdate" class="form-control" placeholder="" readonly>
                    </div>
                  </div>

                </div>
              </div>


              </div>
              <div class="form-actions">
                <div class="card-body border-top">
                  <% if (typeof param.memberid != "undefined" && param.memberid) { %>                   
                    <button type="button" id="btnupdate" class="btn btn-success rounded-pill px-4"> 
                      <div class="d-flex align-items-center">
                          <i data-feather="save" class="feather-sm me-1 fill-icon"></i> 저장
                      </div>
                    </button>
                    <button type="button" id="btndelete" class="btn btn-danger rounded-pill px-4"> 
                      <div class="d-flex align-items-center">
                          <i data-feather="delete" class="feather-sm me-1 fill-icon"></i> 삭제
                      </div>
                    </button>
                  <% } else { %>
                    <button type="submit" id="btnsave" class="btn btn-primary rounded-pill px-4"> 
                      <div class="d-flex align-items-center">
                        <i data-feather="save" class="feather-sm me-1 fill-icon"></i> 등록
                      </div>
                    </button>
                  <% } %>    
                </div>
              </div>
            </form>
          </div>
          <!-- ---------------------
              end Person Info
          ---------------- -->
      </div>        
      </div>

    </div>
    <!-- -------------------------------------------------------------- -->
    <!-- End Page wrapper  -->
    <!-- -------------------------------------------------------------- -->    
    <%- include('../inc/modal.ejs') %>        
    
    <%- include('../inc/footer.ejs') %>        
  </div>    

    
  </body>
</html>
