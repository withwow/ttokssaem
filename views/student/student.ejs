      function dataTableInit() {
        mainTable = $('#dataTable').DataTable({
          "processing": true,
          "serverSide": true,
          //"stateSave": true,
          "ajax": {
            url: "/v1/selStudentList",
            type: "GET",
            dataType: "json",
            data: function (d) {
              d.type = "S";
              d.classyn = "Y";
            },
            dataFilter: function (data) {
              var info = jQuery.parseJSON(data);

              var json = {};
              if (info.code == 0) {
                json.recordsTotal = info.data.totcnt;
                json.recordsFiltered = info.data.totcnt;
                json.data = info.data.lists;
              } else {
                json.recordsTotal = 0;
                json.recordsFiltered = 0;
                json.data = {};
              }
              return JSON.stringify(json); // return JSON string
            },
            error: function(response, ajaxOptions, thrownError) {
                fn_ModalAlert('오류', ''+ thrownError);
            },              
          },
          columns: [  
            {"data": 'branchid'}, 
            {"data": 'branchname'},
            {"data": 'memberno'},
            {"data": 'memberid'},
            {"data": 'membername'},
            {"data": 'schoolcode'},
            {"data": 'schoolname'},
            {"data": null,
              "name": 'grade',
              render: function (data) {
                  let str = '';
                  if(data.grade == '1'){
                    str = '<span class="text-secondary">1학년</span>';
                  } else if(data.grade == '2') {
                    str = '<span class="text-secondary">2학년</span>';
                  } else if(data.grade == '3') {
                    str = '<span class="text-secondary">3학년</span>';
                  } else if(data.grade == '4') {
                    str = '<span class="text-secondary">재수</span>';
                  } else if(data.grade == '5') {
                    str = '<span class="text-secondary">N수</span>';
                  } else {
                    str = '<span class="text-secondary">기타</span>';
                  }

                  return str;
                }     
            },
            {"data":'classexpiredate'},
            {"data": null,
              "name": 'month_blackmark',
              render: function (data) {
                  let str = '';
                  str += '<span class="text-danger">'+ data.month_blackmark+'</span>';
                  str += ' / ';
                  str += '<span class="text-secondary">'+ data.total_blackmark+'</span>';
                  return str;
                }     
            },
            {"data": null,
              "name": '',
              render: function (data) {
                let str = '<button type="button" class="btn btn-secondary">학습계획 결과</button>';
                  return str;
                }     
            },
            {"data": null,
              "name": '',
              render: function (data) {
                let str = '<button type="button" class="btn btn-dark">학습계획 등록</button>';
                  return str;
                }     
            },
            {"data": null,
              "name": '',
              render: function (data) {
                let str = '<button type="button" class="btn btn-secondary">스케쥴</button>';
                  return str;
                }     
            },
            {"data": null,
              "name": '',
              render: function (data) {
                  let str = '<button type="button" class="btn btn-secondary">학사</button>';
                  return str;
                }     
            },
            {"data": null,
              "name": '',
              render: function (data) {
                  let str = '<button type="button" class="btn btn-dark">벌점</button>';
                  return str;
                }     
            },
            {"data": null,
              "name": '',
              render: function (data) {
                  let str = '<button type="button" class="btn btn-dark">결제</button>';
                  return str;
                }     
            },
            {"data": null,
              "name": '',
              render: function (data) {
                  let str = '<button type="button" class="btn btn-secondary">푸시</button>';
                  return str;
                }     
            },
            {"data": null,
              "name": '',
              render: function (data) {
                  let str = '';
                  if(data.vocaplanid == '')
                    str = '<button type="button" class="btn btn-secondary">영단어</button>';
                  else
                    str = '<button type="button" class="btn btn-primary">영단어</button>';
                  return str;
                }     
            },                            
            {"data": null,
              "name": '',
              render: function (data) {
                  let str = '<button type="button" class="btn btn-success">관리</button>';
                  return str;
                }     
            },
          ],
          columnDefs: [ 
          {
              targets: [],
              width: 100
            },
            {
              visible: false,
              targets: [0,1,2,3,5],
            },
            {
              className: "text-center",
              targets: ["_all"]
            },             
            {
              orderable: false,
              targets: [0,10,11,12,13,14,15,16,17]
            }
          ],
          "fnRowCallback": function (nRow, aData, iDisplayIndex, iDisplayIndexFull) {
            var pIndex = iDisplayIndex % 2;
            if (pIndex == 1) {
              $('td', nRow).css('background-color', '#FEFEFE');
            } else {
              $('td', nRow).css('background-color', '#000000');
            }
          },
          "language": {
            "emptyTable": "데이터가 없습니다.",
            "lengthMenu": "페이지당 _MENU_ 개씩 보기",
            "info": "현재 _START_ - _END_ / _TOTAL_건",
            "infoEmpty": "데이터 없음",
            "infoFiltered": "( _MAX_건의 데이터에서 검색됨 )",
            "search": "검색어",
            "zeroRecords": "일치하는 데이터가 없습니다.",
            "loadingRecords": "검색 중...",
            "paginate": {
              "next": "다음",
              "previous": "이전"
            },
            "processing": "데이터를 조회 중입니다."
          },

          scrollX: true,
          scrollCollapse: true,

          destroy: true,
          pageLength: 10, // 페이지 길이

          lengthChange: true, // 표시 건수기능 숨기기
          searching: true, // 검색 기능 숨기기
          ordering: true, // 정렬 기능 숨기기
          info: true, // 정보 표시 숨기기
          paging: true, // 페이징 기능 숨기기

          order: [
          ],
          dom: 'frtip',
          "initComplete": function (settings, json) {
          }
        });   

        // View 보기 준비 : Click DataTables TD
        $('#dataTable tbody').on('click', 'td', function() {
          var tdIndex = mainTable.cell(this).index().column;

          if (tdIndex == 10) {
            // 학습계획 처리
            openStudyplanModal(`${mainTable.row(this).data().memberid}`);
          }

          if (tdIndex == 11) {
            // 학습계획 등록
            openRegStudyplanModal(`${mainTable.row(this).data().memberid}`);
          }

          if (tdIndex == 12) {
            // 스케쥴
            openScheduleModal(`${mainTable.row(this).data().memberid}`);
          }

          if (tdIndex == 13) {
            // 학사
            openAffairModal(`${mainTable.row(this).data().memberid}`);
          }

          if (tdIndex == 14) {
            // 벌점
            openBlackmarkModal(`${mainTable.row(this).data().memberid}`);
          }
          
          if (tdIndex == 15) {
            // 결제 
            openPaymentModal(`${mainTable.row(this).data().memberid}`);
          }  
          
          if (tdIndex == 16) {
            // 푸시 
            openPushModal(`${mainTable.row(this).data().memberid}`);
          } 

          if (tdIndex == 17) {
            // 영단어 
            openVocaModal(`${mainTable.row(this).data().memberid}`);
          } 

          if (tdIndex == 18) {
            // 학부모관리 
            openParentsModal(`${mainTable.row(this).data().memberid}`);
          } 
        }); 

      } // end dataTableInit

    </script>
    
