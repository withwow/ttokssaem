        $('#modalPopupLgBody').html('<iframe class="embed-responsive-item" width="100%" height="100%" src=" ' + src + ' " scrolling="yes" allowfullscreen></iframe>');

        $popup.modal('show');
            
        $('#btnPopupLgYes').off('click').click(function () {
            $('#modalPopupLgBody').html('');
            $popup.modal('hide');
        });

