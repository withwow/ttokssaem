    <script type="text/javascript">
      var mainTable = '';

      $(document).ready(function () {
        dataTableInit(); 

      }); // end ready


      function reCompute() {
        var url = '/v1/reCompute';
          var title = '알림';
          var message = '처리 되었습니다';

          var data = {};
          data.memberid = '<%= param.memberid %>';
          data.memodate = '<%= param.memodate %>';
          data.degree = '<%= param.degree %>';

          $.ajax({
            type: "POST",
            url: url,
            dataType: 'json',
            data: data,
            async: false,
            success: function (info) {
              code = info.code;
              if (code == 0) {
                fn_ModalAlert(title, message);
              } else if (code == 404) {
                fn_ModalAlert(title, '비밀번호가 틀립니다');
              } else {
                fn_ModalAlert('알림', '비정상 응답입니다.');
                return false;
              }
            },
            error: function(response, ajaxOptions, thrownError) {
              fn_ModalAlert('오류', ''+ thrownError);
            },            
          })    
      }

      function correctVocaSolve(id, result) {
        var url = '/v1/correctVocaSolve';
          var title = '알림';
          var message = '처리 되었습니다';

          var data = {};
          data.id = id;
          if(result == 'O')
            data.result = 'X';
          else
            data.result = 'O';

          $.ajax({
            type: "POST",
            url: url,
            dataType: 'json',
            data: data,
            async: false,
            success: function (info) {
              code = info.code;
              if (code == 0) {
                mainTable.ajax.reload();
                fn_ModalAlert(title, message);
              } else if (code == 404) {
                fn_ModalAlert(title, '비밀번호가 틀립니다');
              } else {
                fn_ModalAlert('알림', '비정상 응답입니다.');
                return false;
              }
            },
            error: function(response, ajaxOptions, thrownError) {
              fn_ModalAlert('오류', ''+ thrownError);
            },            
          })    
      }


      function dataTableInit() {
        mainTable = $('#dataTable').DataTable({
          "processing": true,
          "serverSide": true,
          //"stateSave": true,
          "ajax": {
            url: "/v1/selVocaSolveList",
            type: "GET",
            dataType: "json",
            data: function (d) {
              <% if (typeof param.memberid != "undefined" && param.memberid) { %>                   
                d.memberid = '<%= param.memberid %>';
              <% } %>     
              <% if (typeof param.memodate != "undefined" && param.memodate) { %>                   
                d.memodate = '<%= param.memodate %>';
              <% } %>     
              <% if (typeof param.degree != "undefined" && param.degree) { %>                   
                d.degree = '<%= param.degree %>';
              <% } %>     
            },
            dataFilter: function (data) {
              var info = jQuery.parseJSON(data);

              var json = {};
              if (info.code == 0) {
                json.recordsTotal = info.data.totcnt;
                json.recordsFiltered = info.data.totcnt;
                json.data = info.data.lists;
              } else {
                json.recordsTotal = 0;
                json.recordsFiltered = 0;
                json.data = {};
              }
              return JSON.stringify(json); // return JSON string
            },
            error: function(response, ajaxOptions, thrownError) {
                fn_ModalAlert('오류', ''+ thrownError);
            },              
          },
          columns: [  
            {"data": 'id'}, 
            {"data": 'memberid'},
            {"data": 'membername'},
            {"data": 'memodate'},
            {"data": 'degree'},
            {"data": 'vocalevel'},
            {"data": 'vocalevel_name'}, 
            {"data": 'vocano'},
            {"data": 'word'},
            {"data": 'voca_answer'},
            {"data": 'answer'},
            {"data": null,
              "name": 'result',
              render: function (data) {
                  let str = '-';
                  if( data.result == 'O')
                    str = 'O';
                  else 
                    str = 'X';

                  return str;
                }   
            },
            {"data": null,
             "name": '',
              render: function (data) {
                  let str = '-';
                  str = `<button type="button" class="btn btn-primary">정정하기</button>`;
                  return str;
                }   
            },         
          ],
          columnDefs: [ 
          {
              targets: ["_all"],
              width: 100
            },
            {
              visible: false,
              targets: [0,1,5],
            },
            {
              className: "text-center",
              targets: ["_all"]
            },             
            {
              orderable: false,
              targets: []
            }
          ],
          "fnRowCallback": function (nRow, aData, iDisplayIndex, iDisplayIndexFull) {
            var pIndex = iDisplayIndex % 2;
            if (pIndex == 1) {
              $('td', nRow).css('background-color', '#FEFEFE');
            } else {
              $('td', nRow).css('background-color', '#000000');
            }
          },
          "language": {
            "emptyTable": "데이터가 없습니다.",
            "lengthMenu": "페이지당 _MENU_ 개씩 보기",
            "info": "현재 _START_ - _END_ / _TOTAL_건",
            "infoEmpty": "데이터 없음",
            "infoFiltered": "( _MAX_건의 데이터에서 검색됨 )",
            "search": "검색어",
            "zeroRecords": "일치하는 데이터가 없습니다.",
            "loadingRecords": "검색 중...",
            "paginate": {
              "next": "다음",
              "previous": "이전"
            },
            "processing": "데이터를 조회 중입니다."
          },

          scrollX: true,
          scrollCollapse: true,

          destroy: true,
          pageLength: 100, // 페이지 길이

          lengthChange: true, // 표시 건수기능 숨기기
          searching: false, // 검색 기능 숨기기
          ordering: true, // 정렬 기능 숨기기
          info: true, // 정보 표시 숨기기
          paging: true, // 페이징 기능 숨기기

          order: [
          ],
          dom: '<"toolbar">frtip',
          "initComplete": function (settings, json) {
            $("div.toolbar").html('<button class="btn btn-primary py-1" style="width:100px;" id="btnreg" name="btnreg" onclick="reCompute()">계산하기</button>'); 
          },   
        });   

        // View 보기 준비 : Click DataTables TD
        $('#dataTable tbody').on('click', 'td', function() {
          var tdIndex = mainTable.cell(this).index().column;
            if (tdIndex == 12) {
              // 정정하기
              correctVocaSolve(`${mainTable.row(this).data().id}`, `${mainTable.row(this).data().result}`);
            }
        }); 

      } // end dataTableInit

      
    </script>
    
  </head>
