    <script type="text/javascript">
      var canReg = '<%= permission.reg %>' === 'Y';
      var canUpd = '<%= permission.upd %>' === 'Y';
      var canDel = '<%= permission.del %>' === 'Y';
      var periodMap = {};

      $(document).ready(function () {
        loadPeriods();

        $('#btnnew').click(function () { resetForm(); });
        $('#btnsave').click(function () { savePeriod('N'); });
        $('#btndel').click(function () { deletePeriod('N'); });

        if (!canReg) $('#btnnew').hide();
      }); // end ready

      function fmtDate(yyyymmdd) {
        if (!yyyymmdd || yyyymmdd.length !== 8) return '';
        return `${yyyymmdd.substring(0, 4)}-${yyyymmdd.substring(4, 6)}-${yyyymmdd.substring(6, 8)}`;
      }

      function modeName(mode) {
        return mode === 'CSAT' ? '수능 시간표' : '평시 시간표';
      }

      function escapeHtml(str) {
        return $('<div>').text(str == null ? '' : String(str)).html();
      }

      function loadPeriods() {
        $.ajax({
          type: 'GET',
          url: '/v1/selTimetablePeriodList',
          dataType: 'json',
          success: function (info) {
            if (info.code != 0) {
              fn_ModalAlert('알림', '비정상 응답입니다.');
              return;
            }
            renderStatus(info.data.current, info.data.next);
            renderList(info.data.lists);
            renderSlots(info.data.slots);
          },
          error: function (response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', '' + thrownError);
          },
        });
      }

      function renderStatus(current, next) {
        let str = `오늘(02시 기준 ${fmtDate(current.today)})은 <b>${modeName(current.mode)}</b>입니다.`;
        if (current.mode !== 'NORMAL') {
          str += ` (${escapeHtml(current.title)}, ${fmtDate(current.startdate)} ~ ${fmtDate(current.enddate)})`;
        }
        if (next) {
          str += `<br>다음 전환: ${fmtDate(next.startdate)}부터 ${modeName(next.mode)} (${escapeHtml(next.title)})`;
        } else if (current.mode === 'NORMAL') {
          str += '<br>예정된 수능 기간이 없습니다. 올해 수능 기간을 등록해 주세요.';
        }
        $('#statusbox').html(str);
      }

      function renderList(lists) {
        periodMap = {};
        let $tbody = $('#periodTable tbody').empty();
        if (!lists || lists.length === 0) {
          $tbody.append('<tr><td colspan="8" class="text-center">등록된 기간이 없습니다.</td></tr>');
          return;
        }
        lists.forEach(function (row) {
          periodMap[row.periodid] = row;
          let statusClass = row.status === '적용중' ? 'text-primary fw-bold' : (row.status === '예정' ? 'text-success' : 'text-muted');
          $tbody.append(
            `<tr style="cursor:pointer" onclick="editPeriod(${Number(row.periodid)})">` +
              `<td class="text-center">${row.mode === 'CSAT' ? '수능' : '평시'}</td>` +
              `<td>${escapeHtml(row.title)}</td>` +
              `<td class="text-center">${fmtDate(row.startdate)}</td>` +
              `<td class="text-center">${fmtDate(row.enddate)}</td>` +
              `<td class="text-center">${row.days}일</td>` +
              `<td class="text-center ${statusClass}">${row.status}</td>` +
              `<td>${escapeHtml(row.memo)}</td>` +
              `<td class="text-center">${escapeHtml(row.reguserid)}<br><small>${row.upddate || row.regdate || ''}</small></td>` +
            '</tr>'
          );
        });
      }

      function renderSlots(slots) {
        let normal = (slots || []).filter(s => s.mode === 'NORMAL');
        let csat = (slots || []).filter(s => s.mode === 'CSAT');
        let max = Math.max(normal.length, csat.length);
        let $tbody = $('#slotTable tbody').empty();
        for (let i = 0; i < max; i++) {
          let n = normal[i], c = csat[i];
          $tbody.append(
            '<tr>' +
              `<td class="text-center">${i + 1}</td>` +
              `<td>${n ? escapeHtml(n.label + ' ' + (n.timetext || '')) : '-'}</td>` +
              `<td>${c ? escapeHtml(c.label + ' ' + (c.timetext || '')) : '-'}</td>` +
            '</tr>'
          );
        }
      }

      function resetForm() {
        $('#formtitle').text('수능 기간 등록');
        $('#periodid').val('');
        $('#title').val('');
        $('#startdate').datepicker('update', '');
        $('#enddate').datepicker('update', '');
        $('#memo').val('');
        $('#useyn').val('Y');
        $('#btndel').hide();
        $('#btnsave').toggle(canReg);
      }

      function editPeriod(periodid) {
        let row = periodMap[periodid];
        if (!row) return;
        $('#formtitle').text('수능 기간 수정');
        $('#periodid').val(row.periodid);
        $('#title').val(row.title);
        $('#startdate').datepicker('update', fmtDate(row.startdate));
        $('#enddate').datepicker('update', fmtDate(row.enddate));
        $('#memo').val(row.memo || '');
        $('#useyn').val(row.useyn);
        $('#btnsave').toggle(canUpd);
        $('#btndel').toggle(canDel);
      }

      function savePeriod(confirmYn) {
        let data = {
          periodid: $('#periodid').val(),
          title: $('#title').val(),
          startdate: $('#startdate').val(),
          enddate: $('#enddate').val(),
          memo: $('#memo').val(),
          useyn: $('#useyn').val(),
          confirm: confirmYn,
        };

        $.ajax({
          type: 'POST',
          url: '/v1/saveTimetablePeriod',
          dataType: 'json',
          data: data,
          success: function (info) {
            if (info.code == 0) {
              fn_ModalAlert('알림', '저장되었습니다.').then(function () {
                resetForm();
                loadPeriods();
              });
            } else if (info.code == 409) {
              fn_ModalConfirm('확인', escapeHtml(info.data.message)).then(function (yes) {
                if (yes == 1) savePeriod('Y');
              });
            } else if (info.code == 999) {
              fn_ModalAlert('알림', '세션이 만료되었습니다. 다시 로그인해 주세요.');
            } else {
              fn_ModalAlert('알림', escapeHtml((info.data && info.data.message) || '저장하지 못했습니다.'));
            }
          },
          error: function (response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', '' + thrownError);
          },
        });
      }

      function deletePeriod(confirmYn) {
        let periodid = $('#periodid').val();
        if (!periodid) return;

        let send = function (c) {
          $.ajax({
            type: 'POST',
            url: '/v1/delTimetablePeriod',
            dataType: 'json',
            data: { periodid: periodid, confirm: c },
            success: function (info) {
              if (info.code == 0) {
                fn_ModalAlert('알림', '삭제되었습니다.').then(function () {
                  resetForm();
                  loadPeriods();
                });
              } else if (info.code == 409) {
                fn_ModalConfirm('확인', escapeHtml(info.data.message)).then(function (yes) {
                  if (yes == 1) send('Y');
                });
              } else {
                fn_ModalAlert('알림', escapeHtml((info.data && info.data.message) || '삭제하지 못했습니다.'));
              }
            },
            error: function (response, ajaxOptions, thrownError) {
              fn_ModalAlert('오류', '' + thrownError);
            },
          });
        };

        if (confirmYn === 'Y') {
          send('Y');
        } else {
          fn_ModalConfirm('확인', '이 기간을 삭제할까요?').then(function (yes) {
            if (yes == 1) send('N');
          });
        }
      }
    </script>
    <link href="/assets/libs/bootstrap-datepicker/dist/css/bootstrap-datepicker.min.css" rel="stylesheet">

  </head>
  <body>
  <!-- -------------------------------------------------------------- -->
  <!-- Preloader - style you can find in spinners.css -->
