  <!-- -------------------------------------------------------------- -->
	<!-- Main wrapper - style you can find in pages.scss -->
	<!-- -------------------------------------------------------------- -->
	<div id="main-wrapper">
    <%- include('../inc/header.ejs') %>    

    <%- include('../inc/nav.ejs') %>    

    <!-- -------------------------------------------------------------- -->
    <!-- Page wrapper  -->
    <!-- -------------------------------------------------------------- -->
    <div class="page-wrapper bg-white">
      <div class="page-breadcrumb">
        <div class="row">
          <div class="col-5 align-self-center">
            <h4 class="page-title">시간표 기간 관리</h4>
            <div class="d-flex align-items-center">
              <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                  <li class="breadcrumb-item"><a href="#">홈</a></li>
                  <li class="breadcrumb-item active" aria-current="page">시간표 기간 관리</li>
                </ol>
              </nav>
            </div>
          </div>
        </div>
      </div>

      <div class="container-fluid">
        <div class="alert alert-info" id="statusbox">불러오는 중...</div>
        <p class="text-muted small mb-3">
          등록한 기간(시작일~종료일, 양끝 포함)에는 어드민 학습계획 화면과 앱이 자동으로 수능 시간표를 사용하고, 그 외 날짜는 평시 시간표를 사용합니다.
          수능/평시 여부는 학습계획 날짜 기준이며, 하루는 새벽 02시에 바뀝니다. 매년 수능 기간만 등록하면 소스 수정은 필요 없습니다.
        </p>

        <div class="row">
          <div class="col-lg-8">
            <div class="card">
              <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                  <h5 class="card-title mb-0">수능 기간 목록</h5>
                  <button class="btn btn-primary py-1" id="btnnew" type="button">신규 등록</button>
                </div>
                <table id="periodTable" class="table table-hover table-bordered">
                  <thead class="bg-light-primary text-dark">
                    <tr>
                      <th class="text-center">시간표</th>
                      <th class="text-center">제목</th>
                      <th class="text-center">시작일</th>
                      <th class="text-center">종료일</th>
                      <th class="text-center">일수</th>
                      <th class="text-center">상태</th>
                      <th class="text-center">메모</th>
                      <th class="text-center">등록자/일시</th>
                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div>
            </div>
          </div>

          <div class="col-lg-4">
            <div class="card">
              <div class="card-body">
                <h5 class="card-title" id="formtitle">수능 기간 등록</h5>
                <input type="hidden" id="periodid" name="periodid">
                <div class="mb-3">
                  <label class="control-label">제목</label>
                  <input type="text" class="form-control" id="title" name="title" maxlength="50" placeholder="예: 2028학년도 수능">
                </div>
                <div class="mb-3">
                  <label class="control-label">시작일 (포함)</label>
                  <input type="text" class="form-control mydatepicker" id="startdate" name="startdate" placeholder="yyyy-mm-dd" autocomplete="off">
                </div>
                <div class="mb-3">
                  <label class="control-label">종료일 (포함, 보통 수능 당일)</label>
                  <input type="text" class="form-control mydatepicker" id="enddate" name="enddate" placeholder="yyyy-mm-dd" autocomplete="off">
                </div>
                <div class="mb-3">
                  <label class="control-label">사용여부</label>
                  <select class="form-select form-control" id="useyn" name="useyn">
                    <option value="Y">사용</option>
                    <option value="N">사용안함</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="control-label">메모</label>
                  <input type="text" class="form-control" id="memo" name="memo" maxlength="200">
                </div>
                <button class="btn btn-primary" id="btnsave" type="button">저장</button>
                <button class="btn btn-danger" id="btndel" type="button" style="display:none">삭제</button>
              </div>
            </div>

            <div class="card">
              <div class="card-body">
                <h5 class="card-title">교시 정의 (읽기 전용)</h5>
                <table id="slotTable" class="table table-sm table-bordered">
                  <thead class="bg-light-primary text-dark">
                    <tr>
                      <th class="text-center">칸</th>
                      <th class="text-center">평시</th>
                      <th class="text-center">수능</th>
                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <%- include('../inc/modal.ejs') %>

    <%- include('../inc/footer.ejs') %>
  </div>

    <script src="/assets/libs/bootstrap-datepicker/dist/js/bootstrap-datepicker.min.js"></script>
    <script>
      jQuery('.mydatepicker').datepicker({
        format: 'yyyy-mm-dd',
        autoclose: true,
        todayHighlight: true
      });
    </script>
  </body>
</html>
