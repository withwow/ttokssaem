    <script type="text/javascript">
      var old_price = "";
      $(document).ready(function () {
        // 데이터 불러오기
        loadBmInfo();

        // 버튼 클릭
        $( "#btnupdate" ).click(function() {
          $('#mode').val('mod');
          $("#frm").submit();
        });

        $( "#btndelete" ).click(function() {
          $('#mode').val('del');
          $("#frm").submit();
        });

        $("#frm").submit(function(){ 
          confirmProcess();
          return false;
        });


      }); // end ready

      function selectCurrentBranch(branchid, branchname, disabled) {
        fn_Set_Select_Selected('branchid', branchid, branchname );

        <% if ( userinfo.branchid !== 'BR00000000' ) { %>                   
          $('#branchid').prop('disabled','disabled');
        <% } else { %>
          if( disabled )
            $('#branchid').attr('readonly',true);
        <% } %>   
      }

      function loadBmInfo() {
        let data = {};

        <% if (typeof param.codeid != "undefined" && param.codeid) { %>                   
          data.codeid = '<%= param.codeid %>';
        <% } %>                                        

        if(data.codeid === undefined){

          // selectCurrentBranch('<%= userinfo.branchid %>', 'empty', false)

          return false;
        }

        $.ajax({
            crossOrigin : true,
            type: "POST",
            url: "/v1/selBm",
            dataType: 'json',
            data: data,
            async: false,
            success: function (info) {
                code = info.code;
                if (code === 0) {
                  //let lists = info.data;
                  setBmInfo(info.data);  
                } else if (code === 999) {
                    fn_ModalAlert('알림', '다시 로그인 하여 주세요');
                    location.reload(); 
                } else {
                    fn_ModalAlert('알림', '비정상 응답입니다.');
                    return false;
                }
            },
            error: function(response, ajaxOptions, thrownError) {
                fn_ModalAlert('오류', ''+ thrownError);
            },                     
        }); // end  $.ajax        
      }

      function confirmProcess(){
        var mode = $('#mode').val();
        var title = '확인';
        var message = '';
        if(mode == 'reg'){
          message = '등록 하시겠습니까?';
        } else if(mode == 'mod'){
          message = '수정 하시겠습니까?';
        } if(mode == 'del'){
          message = '삭제 하시겠습니까?';
        }

        var confirmIs = fn_ModalConfirm(title, message);  
          confirmIs.then( function (ret){ 
            if( ret ==   1   ) { 
              saveBmInfo();
            } else {
              return false;
            }
        });        
      }

      function saveBmInfo(){
        var mode = $('#mode').val();

        var url = '';
        var title = '알림';
        var message = '';
        if(mode == 'reg'){
          // 등록 
          message = '등록되었습니다';
          url = "/v1/insBm";
        } else if(mode == 'mod'){
          // 수정
          message = '수정되었습니다';
          url = "/v1/updBm";
        } if(mode == 'del'){
          // 삭제
          message = '삭제되었습니다';
          url = "/v1/delBm";
        }

        var data = $("#frm").serialize();

        $.ajax({
          type: "POST",
          url: url,
          dataType: 'json',
          data: data,
          async: false,
          success: function (info) {
            code = info.code;
            if (code == 0) {
              fn_ModalAlert(title, message);
            } else {
              fn_ModalAlert('알림', '비정상 응답입니다.');
              return false;
            }
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },            
        })
      }

      function setBmInfo(data){

        // selectCurrentBranch(data.branchid, data.branchname, true);

        $('#codeid').val(data.codeid);
        $('#code').val(data.code);
        $('#codename').val(data.codename);
        $('#codevalue').val(data.codevalue);
        $('#codeorder').val(data.codeorder);

      }
  </script>
    
  </head>
  <body>
