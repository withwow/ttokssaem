      <div class="row">
        <div class="col-lg-12">

          <div class="card">
            <form id="frm" method="POST">
              <% if (typeof param.codeid != "undefined" && param.codeid) { %>                   
                <input type="hidden" id="mode" name="mode" value="mod" />
              <% } else { %>
                <input type="hidden" id="mode" name="mode" value="reg" />
              <% } %>                                        
              <div class="card-body">
                <h4 class="card-title">기본 정보</h4>
                <div class="row">

                  <!-- <div class="col-md-12">
                    <div class="mb-3">
                      <label class="control-label">지점 <span class="text-danger">*</span></label>
                      <select class="form-control" id='branchid' name='branchid' required>   
                        <option value='' selected>-- 선택 --</option>                   
                        <% for(var i = 0; i < branchlist.length; i++){ %>
                          <option value='<%= branchlist[i].branchid %>'><%= branchlist[i].branchname %></option>                   
                        <% } %>
                      </select>                            
                    </div>
                  </div> -->

                  <div class="col-md-12">
                    <div class="mb-3">
                      <label class="control-label">코드 ID</label>
                      <input type="text" id="codeid" name="codeid" class="form-control" placeholder="자동생성" readonly>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">벌점 코드 (중복되지 않도록 주의요함)</label>
                      <input type="text" id="code" name="code" class="form-control" placeholder="A">
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">경우</label>
                      <input type="text" id="codename" name="codename" class="form-control" placeholder="경우">
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">벌점</label>
                      <input type="text" id="codevalue" name="codevalue" class="form-control" placeholder="숫자로">
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="control-label">정렬순서</label>
                      <input type="text" id="codeorder" name="codeorder" class="form-control" placeholder="숫자로">
                    </div>
                  </div>

                </div>
              </div>


              </div>
              <div class="form-actions">
                <div class="card-body border-top">
                  <% if (typeof param.codeid != "undefined" && param.codeid) { %>                   
                    <button type="button" id="btnupdate" class="btn btn-success rounded-pill px-4"> 
                      <div class="d-flex align-items-center">
                          <i data-feather="save" class="feather-sm me-1 fill-icon"></i> 저장
                      </div>
                    </button>
                    <button type="button" id="btndelete" class="btn btn-danger rounded-pill px-4"> 
                      <div class="d-flex align-items-center">
                          <i data-feather="delete" class="feather-sm me-1 fill-icon"></i> 삭제
                      </div>
                    </button>
                  <% } else { %>
                    <button type="submit" id="btnsave" class="btn btn-primary rounded-pill px-4"> 
                      <div class="d-flex align-items-center">
                        <i data-feather="save" class="feather-sm me-1 fill-icon"></i> 등록
                      </div>
                    </button>
                  <% } %>    
                </div>
              </div>
            </form>
