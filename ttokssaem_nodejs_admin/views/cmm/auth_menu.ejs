    <script type="text/javascript">
      $(document).ready(function () {
        loadAuthID();


        $('#sel_auth_id').change( function() {
          let selected = $('#sel_auth_id option:selected').val();
          $('#auth_id').val(selected);
          loadAuthMenu(selected);
        });

				// 권한등록
				$('#btnsave').click(function() {
					doSave();
				});
				
				$('#all_check').click(function() {
					onAllChecked();
				});        
      });
      
      function loadAuthMenu(selected) {
        let data = {};
        data.auth_id = selected;

        if(data.auth_id === '') return;

        $.ajax({
            crossOrigin : true,
            type: "GET",
            url: "/v1/selAuthMenuList",
            dataType: 'json',
            data: data,
            async: false,
            success: function (info) {
                code = info.code;
                if (code === 0) {
                  let lists = info.data.lists;
                  $('#check_list').html('');
								  for( var i=0; i<lists.length; i++ ) {
									  var data = lists[i];
									  onMenuList(data, i);
							  	}

                  fn_footerCheck();

                } else if (code === 999) {
                    fn_ModalAlert('알림', '다시 로그인 하여 주세요');
                    location.reload(); 
                } else {
                    fn_ModalAlert('알림', '비정상 응답입니다.');
                    return false;
                }
            },
            error: function(response, ajaxOptions, thrownError) {
                fn_ModalAlert('오류', ''+ thrownError);
            },                     
        }); // end  $.ajax     
      }

      function doSave() {
        var url = url = "/v1/regAuthMenu";
        var data = $("#frm").serialize();

        $.ajax({
          type: "POST",
          url: url,
          dataType: 'json',
          data: data,
          async: false,
          success: function (info) {
            code = info.code;
            if (code == 0) {
              fn_ModalAlert('알림', '저장되었습니다.');
            } else {
              fn_ModalAlert('알림', '비정상 응답입니다.');
              return false;
            }
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },            
        });   
      }

			/*
			* 각 ROW의 저장된 메뉴 매핑 정보의 표현 처리 
			*/
      function onMenuList(data, idx) {
				// 저장할 내용 컬럼 정보 정의
				var cols = ['btn_read', 'menu_id', 'btn_reg', 'btn_upd', 'btn_del', 'btn_xlsd', 'btn_xlsu'];
			
				// 목록의 하나의 ROW를 처리하기 위한 TR 태그 생성
				var tr = document.createElement('tr');

				// 컬럼 생성
				for( var i=0; i<cols.length; i++ ) {
					
					// 해당 ROW의 인텍스 값을 등록 처리
					var td = document.createElement("td");
	 	    	$(td).attr('idx', idx);
	 	    	   
          if(cols[i]=='menu_id') {
            // 메뉴명 등록
            td.appendChild(document.createTextNode(data.menu));
	 	    		   
            // 메뉴 ID 등록
            var input = document.createElement("input");
            $(input).attr('type', 'hidden');
            $(input).attr('id', 'menu_id_' + idx);
            $(input).attr('name', 'menu_id');
            $(input).val(data.menu_id);
	 	    		   
            // 해당 셀에 등록 
            td.appendChild(input);
          } else {
            // 화면에서 처리를 위한 체크박스 생성
            var chk = document.createElement("input");
            $(chk).attr('type', 'checkbox');
            $(chk).attr('id', cols[i] + '_chk_' + idx);
            $(chk).attr('target', cols[i]);	// 체크박스는 정상적이 parameter 전달이 되지 않으므로 다른 input에 정보를 전달한 정보 틍록

	 	       	// 실제 저장할 input 태그 정보 등록
						var input = document.createElement("input");
						$(input).attr('type', 'hidden');
            $(input).attr('id', cols[i] + '_' + idx);
						$(input).attr('name', cols[i]);
						
						// 체크박스 선택 시 input으로 값을 전달
						chk.onclick = function() {
              var idx = this.parentNode.getAttribute('idx');
              var target = $(this).attr('target');
							
							if(this.checked) {
								$('#'+target + '_' + idx).val('Y');
							} else {
								$('#'+target + '_' + idx).val('N');
							}
						}
	 	       			
            var v;
            if(cols[i]=='btn_read') {
              v = data.btn_read;
            } else if(cols[i]=='btn_reg') {
              v = data.btn_reg;
            } else if(cols[i]=='btn_upd') {
              v = data.btn_upd;
            } else if(cols[i]=='btn_del') {
              v = data.btn_del;
            } else if(cols[i]=='btn_xlsd') {
              v = data.btn_xlsd;
            } else if(cols[i]=='btn_xlsu') {
              v = data.btn_xlsu;
            }
	 	       			
            $(td).css('text-align', 'center');
	 	       			
	 	       	// 해당 컬럼의 값에 따른 체크박스 처리 및 저장값 처리
            if(v=='Y') {
              $(chk).attr('checked', true);
              $(input).val('Y');
            } else {
              $(input).val('N');
            }
	 	       			
            td.appendChild(chk);
            td.appendChild(input);
          }
          $(tr).append(td);
        }

        $('#check_list').append(tr);
			}

			// 전체 체크박스 처리
			function onAllChecked() {
				// 체크여부
				var chk = document.getElementById('all_check').checked;
				
				var btn_read = document.getElementsByName('btn_read');
				
				for( var i=0; i<btn_read.length; i++ ) {
					// 전체 체크와 동일 처리가 되어야 하므로 그대로 체크
					document.getElementById('btn_read_chk_'+i).checked = chk;
					
					// 저장값 처리
					if(chk) {
						btn_read[i].value = 'Y';
					} else {
						btn_read[i].value = 'N';
					}
					
				}
			}


      function loadAuthID() {
        let data = {};
        data.search = '';
        // data.start = 0;
        // data.length = 999;

        $.ajax({
            crossOrigin : true,
            type: "GET",
            url: "/v1/selAuthList",
            dataType: 'json',
            data: data,
            async: false,
            success: function (info) {
                code = info.code;
                if (code === 0) {
                  let lists = info.data.lists;
                  $.each( lists, function(k, v){
                    setAuthId(v);
                  });                  
                } else if (code === 999) {
                    fn_ModalAlert('알림', '다시 로그인 하여 주세요');
                    location.reload(); 
                } else {
                    fn_ModalAlert('알림', '비정상 응답입니다.');
                    return false;
                }
            },
            error: function(response, ajaxOptions, thrownError) {
                fn_ModalAlert('오류', ''+ thrownError);
            },                     
        }); // end  $.ajax        
      }

      function setAuthId(obj){
        var pSelectOption = "<option value='" + obj.auth_id + "' >" + obj.auth + "</option>";
        $('#sel_auth_id').append(pSelectOption);       
      }
  </script>
    
