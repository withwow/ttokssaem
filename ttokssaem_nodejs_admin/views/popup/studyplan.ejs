  <!-- -------------------------------------------------------------- -->
	<!-- Main wrapper - style you can find in pages.scss -->
	<!-- -------------------------------------------------------------- -->
	<div id="main-wrapper">
    <!-- -------------------------------------------------------------- -->
    <!-- Page wrapper  -->
    <!-- -------------------------------------------------------------- -->
    <!-- <div class="page-wrapper bg-white"> -->
      <div class="card">
        <h4 class="card-title">학생 : <%= memberinfo.membername %>, <%= memberinfo.schoolname %></h4>
        <form id="frm" method="POST">
        <input type="hidden" id="memberid" name="memberid" value="<%= memberinfo.memberid %>">
        <input type="hidden" id="membername" name="membername" value="<%= memberinfo.membername %>">
        <div class="card-body">
          <!-- row -->
          <div class="row mb-3">
            <div class="col-md-12">
              <div class="mb-3">
                <label class="control-label">학습계획 일자</label>
                <div class="input-group">
                  <input type="text" class="form-control mydatepicker" id="plandate" name="plandate" placeholder="yyyy-mm-dd">
                  
                      <span class="input-group-text">
                          <i data-feather="calendar" class="feather-sm"></i>
                      </span>
                  
                </div>
              </div>
            </div>
          </div>
          <!-- end row -->

          <!-- row -->
          <div class="row mb-3">
            <div class="col-md-12">
              <div class="mb-3">
                <label class="control-label">학습계획 </label>
                <span class="badge ms-2" id="timetableBadge"></span>
              </div>
            </div>

            <!-- 교시 행은 학습계획 일자의 시간표(/v1/selTimetable)로 그린다 -->
            <div class="col-md-12" id="slotRows"></div>
          </div>
          <!-- end row -->

          <!-- row -->
          <div class="row mb-3 mt-5">            
            <div class="col-md-6">
                <label class="control-label">담당자</label>
                <select class="form-control" id='userid' name='userid'>   
                  <option value='' selected>-- 처리하고자 하는 담당자 --</option>
                  <% for(var i = 0; i < userlist.length; i++){ %>
                    <option value='<%= userlist[i].userid %>'><%= userlist[i].username %></option>                   
                  <% } %>                
                </select>   
            </div>

            <div class="col-md-6">
              <label class="control-label">비밀번호</label>
              <input class="form-control password" id="userpw" name="userpw" class="form-control" autocomplete="off"/>
            </div>
          </div>
          <!-- end row -->
          <!-- form-actions -->
          <div class="form-actions">
            <span class="text-danger"></span>
            <div class="card-body border-top">
              <button type="button" id="btnupdate" class="btn btn-success rounded-pill px-4"> 
                <div class="d-flex align-items-center">
                    <i data-feather="save" class="feather-sm me-1 fill-icon"></i> 저장
                </div>
              </button>
            </div>
          </div>
          <!-- end form-actions -->

        </div>
        <!-- end card body-->
        </form>
      </div>
    <!-- </div> -->
    <!-- -------------------------------------------------------------- -->
    <!-- End Page wrapper  -->
    <!-- -------------------------------------------------------------- -->    
    <%- include('../inc/modal.ejs') %>        
    
