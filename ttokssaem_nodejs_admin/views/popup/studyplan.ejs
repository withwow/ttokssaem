    <script src="/assets/extra-libs/taskboard/js/jquery-ui.min.js"></script>
    <!-- Bootstrap tether Core JavaScript -->
    <!-- <script src="../../assets/libs/popper.js/popper.min.js"></script> -->
      <script src="/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Theme Required Js -->
    <script src="/dist/js/app.min.js"></script>
    <script src="/dist/js/app.init.js"></script>
    <script src="/dist/js/app-style-switcher.js"></script>
    <!-- perfect scrollbar JavaScript -->
    <script src="/assets/libs/perfect-scrollbar/dist/perfect-scrollbar.jquery.min.js"></script>
    <script src="/assets/extra-libs/sparkline/sparkline.js"></script>
    <!--Wave Effects -->
    <script src="/dist/js/waves.js"></script>
    <!--Menu sidebar -->
    <script src="/dist/js/sidebarmenu.js"></script>
    <!--Custom JavaScript -->
    <script src="/dist/js/feather.min.js"></script>
    <script src="/dist/js/custom.min.js"></script>
    <script src="/js/common.js"></script>

    <script type="text/javascript">
      $(document).ready(function () {

        let today = new Date();
        today.setHours(today.getHours() - 2); // 02시까지 영업이니
        $('#plandate').val(fn_getY_M_D(today));

        loadStudyPlan();

        $('#plandate').change(function() {
          loadStudyPlan();
        });

        // 버튼 클릭
        $( "#btnupdate" ).click(function() {
          $("#frm").submit();
        });

        $("#frm").submit(function(){ 
          confirmProcess();
          return false;
        });

      }); // end ready

      function insEachItem(idx) {
        var url = '/v1/insEachItem';

        var data = {};
        data.memberid = $("#memberid").val();
        data.plandate = $("#plandate").val();
        data.class = idx + 1;
        data.study = $("textarea[name=study]:eq(" + idx + ")").val();
        data.goalnum = $("input[name=goalnum]:eq(" + idx + ")").val();
        data.achievenum = $("input[name=achievenum]:eq(" + idx + ")").val();

        $.ajax({
          type: "POST",
          url: url,
          dataType: 'json',
          data: data,
          async: false,
          success: function (info) {
            code = info.code;
            if (code == 0) {
              $("input[name=studyplanid]:eq(" + idx + ")").val(info.data.lastid);
            }
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },    
        });
      }

      function delEachItem(idx) {
        var url = '/v1/delEachItem';

        var data = {};
        data.memberid = $("#memberid").val();
        data.plandate = $("#plandate").val();
        data.studyplanid =  $("input[name=studyplanid]:eq(" + idx + ")").val(); 

        $.ajax({
          type: "POST",
          url: url,
          dataType: 'json',
          data: data,
          async: false,
          success: function (info) {
            code = info.code;
            if (code == 0) {
              $("input[name=studyplanid]:eq(" + idx + ")").val(''); 
            }
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },
        });           
      }

      function checkClass(obj, idx) {
        if(obj.checked) {
          $("input[name=classyn]:eq(" + idx + ")").val('Y');
          insEachItem(idx);
        } else {
          $("input[name=classyn]:eq(" + idx + ")").val('N');
          delEachItem(idx);
        }
      }

      function studyClass(obj, idx) {
        if(obj.value == '') {
          $("input[name=classyn]:eq(" + idx + ")").val('N'); 
          $("input[name=classcheck]:eq(" + idx + ")").prop("checked", false); 
        } else {
          $("input[name=classyn]:eq(" + idx + ")").val('Y'); 
          $("input[name=classcheck]:eq(" + idx + ")").prop("checked", true); 
        }
      }

      function confirmProcess() {

        if($("#userid")[0].selectedIndex == 0 ) {
          alert('담당자 선택');
          $("#userid")[0].focus();
          return false; 
        }

        if($('#userpw').val() == ''){
          alert('비밀번호 입력');
          $("#userpw").focus();
          return false;
        }

        var title = '확인';
        var message = '진행 하시겠습니까?';

        var confirmIs = fn_ModalConfirm(title, message);  
          confirmIs.then( function (ret){ 
            if( ret ==   1   ) { 
              doProcess();
            } else {
              return false;
            }
        });        
      }

      function doProcess(){

        var url = '/v1/updStudyplan';
        var title = '알림';
        var message = '처리 되었습니다. 추가가 발생했다면 창을 닫고 다시 열어야 수정 가능합니다.';

        var data = $("#frm").serialize();

        $.ajax({
          type: "POST",
          url: url,
          dataType: 'json',
          data: data,
          async: false,
          success: function (info) {
            code = info.code;
            if (code == 0) {
              fn_ModalAlert(title, message);
            } else if (code == 404) {
              fn_ModalAlert(title, '비밀번호가 틀립니다');
            } else {
              fn_ModalAlert('알림', '비정상 응답입니다.');
              return false;
            }
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },            
        })
      }

      // ---------------------------------------------------------------
      // 시간표 (수능/평시) : 학습계획 일자 기준으로 서버에서 판정
      // class = 행 인덱스 + 1 (저장 규칙은 기존과 동일)
      // ---------------------------------------------------------------
      function fetchTimetable(plandate) {
        let result = null;
        $.ajax({
          type: "POST",
          url: '/v1/selTimetable',
          dataType: 'json',
          data: { plandate: plandate },
          async: false,
          success: function (info) {
            if (info.code == 0) result = info.data;
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },
        });
        return result;
      }

      function escapeHtml(str) {
        return $('<span>').text(str == null ? '' : String(str)).html();
      }

      function rowHtml(idx, label) {
        return `
              <div class="input-group input-group-sm mb-3">
                <div class="input-group-prepend">
                  <div class="form-check">
                    <input type="hidden" class="form-control" name="studyplanid">
                    <input type="hidden" class="form-control" name="classyn" value="N">
                    <input class="form-check-input" type="checkbox" name="classcheck" onchange="checkClass(this, ${idx})">
                    <label class="form-check-label">${label}</label>
                  </div>
                </div>
                <textarea rows="2" class="form-control ms-3" name="study" onchange="studyClass(this, ${idx})"></textarea>
                <div class="input-group-append ms-1">
                  목표 <input type="number" class="form-control" name="goalnum">
                  달성 <input type="number" class="form-control" name="achievenum">
                </div>
              </div>`;
      }

      function renderSlots(timetable) {
        let $rows = $('#slotRows').empty();
        timetable.slots.forEach(function (slot, idx) {
          let label = escapeHtml(slot.label) + (slot.timetext ? `<br><small class="text-muted">${escapeHtml(slot.timetext)}</small>` : '');
          $rows.append(rowHtml(idx, label));
        });

        let $badge = $('#timetableBadge');
        if (timetable.mode === 'CSAT') {
          $badge.attr('class', 'badge ms-2 bg-danger').text(`수능 시간표 (${timetable.title})`);
        } else {
          $badge.attr('class', 'badge ms-2 bg-secondary').text('평시 시간표');
        }
      }

      // 시간표에 없는 칸(class)의 데이터가 있으면 행을 추가해 보이게 한다
      function ensureRows(count) {
        let $rows = $('#slotRows');
        let cur = $rows.find('textarea[name=study]').length;
        for (let idx = cur; idx < count; idx++) {
          $rows.append(rowHtml(idx, `<span class="text-danger">${idx + 1}번 칸<br><small>현재 시간표에 없음</small></span>`));
        }
      }

      function initStudyPlan(newArray) {
        for(let i = 0; i < newArray.length; i++) {
            setStudyPlan(newArray[i]);
        }
      }

      function setStudyPlan(data) {
        let idx = Number(data.class - 1);
        let studyplanid = data.studyplanid;
        let study = data.study;
        let goalnum = data.goalnum;
        let achievenum = data.achievenum;

        if (idx < 0) return;
        ensureRows(idx + 1);

        $("input[name=studyplanid]:eq(" + idx + ")").val(studyplanid); 
        $("input[name=classyn]:eq(" + idx + ")").val('Y'); 
        $("input[name=classcheck]:eq(" + idx + ")").prop("checked", true); 
        $("textarea[name=study]:eq(" + idx + ")").val(study); 
        $("input[name=goalnum]:eq(" + idx + ")").val(goalnum); 
        $("input[name=achievenum]:eq(" + idx + ")").val(achievenum); 
      }

      function resetStudyPlan() {
        let count = $('#slotRows').find('textarea[name=study]').length;
        for(let idx = 0; idx < count; idx++) {
          $("input[name=studyplanid]:eq(" + idx + ")").val(''); 
          $("input[name=classyn]:eq(" + idx + ")").val('N'); 
          $("input[name=classcheck]:eq(" + idx + ")").prop("checked", false); 
          $("textarea[name=study]:eq(" + idx + ")").val(''); 
          $("input[name=goalnum]:eq(" + idx + ")").val(0); 
          $("input[name=achievenum]:eq(" + idx + ")").val(0); 
        }
      }

      function loadStudyPlan() {

        let timetable = fetchTimetable($('#plandate').val());
        if (timetable == null) {
          fn_ModalAlert('알림', '시간표를 불러오지 못했습니다.');
          return false;
        }
        renderSlots(timetable);

        var url = '/v1/selStudyplan'
        var data = $("#frm").serialize();

        $.ajax({
          type: "POST",
          url: url,
          dataType: 'json',
          data: data,
          async: false,
          success: function (info) {
            code = info.code;
            if (code == 0) {
              initStudyPlan(info.data.lists);
            } else {
              fn_ModalAlert('알림', '비정상 응답입니다.');
              return false;
            }
          },
          error: function(response, ajaxOptions, thrownError) {
            fn_ModalAlert('오류', ''+ thrownError);
          },            
        })
      }

  </script>
    
  </head>
  <body>
  <!-- -------------------------------------------------------------- -->
  <!-- Preloader - style you can find in spinners.css -->
  <!-- -------------------------------------------------------------- -->
  <div class="preloader">
    <svg class="tea lds-ripple" width="37" height="48" viewbox="0 0 37 48" fill="none" xmlns="http://www.w3.org/2000/svg">
