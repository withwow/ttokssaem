<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keep the launch appearance identical in the device's dark mode. -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#103E30</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">#103E30</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>

    <!-- 앱 UI는 라이트 테마만 지원하므로 다크 모드에서도 창 배경을 흰색으로 고정한다. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
