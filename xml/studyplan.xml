<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="studyplan"> 

  <select id="selStudyplan">
    SELECT
      studyplanid,
      class,
      study,
      achieveyn
    FROM
      ttokssaemdb.studyplan
    WHERE
      memberid = #{memberid}
      AND plandate = #{plandate}
    ORDER BY
      class
  </select>

  <update id="updStudyplan">
    UPDATE ttokssaemdb.studyplan
    <set>
      achieveyn = #{achieveyn}
    </set>
    <where>
    AND studyplanid = ${studyplanid}
    </where>
  </update>
</mapper>