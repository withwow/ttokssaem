<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="branch"> 

  <select id="totCntBranch">
    <bind name="likeQuery" value="'%' + query + '%'"/>
    SELECT
      count(*) totcnt
    FROM
      ttok.branch branch
    WHERE
      1 = 1
      <if test="branchid != undefined and branchid !=''">    
        AND branch.branchid = #{branchid}
      </if>  
      <if test="query != undefined and query !=''">    
        AND branch.branchname LIKE #{likeQuery}
      </if>                   
  </select>

  <select id="selBranchList">
    <bind name="likeQuery" value="'%' + query + '%'"/>
    SELECT R1.* FROM(
      SELECT
        branch.branchid,
        branch.branchname,
        branch.ceo,
        branch.contact,
        branch.useyn,
        DATE_FORMAT(branch.regdate, '%Y-%m-%d %H:%i:%s') regdate
      FROM
        ttok.branch branch
      <where>
        <if test="branchid != undefined and branchid !=''">    
          AND branch.branchid = #{branchid}
        </if>  
        <if test="query != undefined and query !=''">    
          AND branch.branchname LIKE #{likeQuery}
        </if> 
      </where>                 
      <trim prefix="ORDER BY">
        <if test="sortorder == ''"> branch.branchid </if>
        <if test="sortorder == 'branchname'"> branch.branchname </if>
        <if test="sortorder == 'ceo'"> branch.ceo </if>
        <if test="sortorder == 'contact'"> branch.contact </if>
        <if test="sortorder == 'useyn'"> branch.useyn </if>
        <if test="sortorder == 'regdate'"> branch.regdate </if>
        <if test="dir == ''"> ASC </if>
        <if test="dir == 'asc'"> ASC </if>
        <if test="dir == 'desc'"> DESC </if>
      </trim>       
    ) R1
    <if test="start != undefined and start !=''">    
    LIMIT ${length} OFFSET ${start}    
    </if>
  </select>

  <select id="selBranch">
    SELECT
      branch.branchid,
      branch.branchname,
      branch.ceo,
      branch.contact,
      branch.useyn,
      DATE_FORMAT(branch.regdate, '%Y-%m-%d %H:%i:%s') regdate
    FROM
      ttok.branch branch
    <where>
      AND branch.branchid = #{branchid}
    </where>
  </select>


  <insert id="insBranch">
    INSERT INTO ttok.branch (
      branchid
    ) VALUES (
      #{branchid}
    )
  </insert>

  <update id="updBranch">
    UPDATE ttok.branch
    <set>
      <if test="branchname != undefined and branchname !=''">
        branchname = #{branchname},
      </if>
      <if test="ceo != undefined and ceo !=''">
        ceo = #{ceo},
      </if>
      <if test="contact != undefined and contact !=''">
        contact = #{contact},
      </if>
      <if test="useyn != undefined and useyn !=''">
        useyn = #{useyn},
      </if>
    </set>
    <where>
      AND branchid = #{branchid}
    </where>
  </update>

  <delete id="delBranch">
    DELETE FROM ttok.branch
    <where>
      AND branchid = #{branchid}
    </where>    
  </delete>


</mapper>